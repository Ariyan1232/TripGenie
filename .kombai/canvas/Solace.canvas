:rgba(255,255,255,.55);\n    font-size:13px;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    font-weight:600;\n  }\n  .phone{\n    position:relative;\n    width:min(390px,92vw);\n    aspect-ratio:390/883;\n    border-radius:0;\n    padding:0;\n    background:linear-gradient(160deg,#3a3a44,#0e0e12);\n    box-shadow:none;\n  }\n  .screen{\n    position:relative;\n    width:100%;\n    height:100%;\n    border-radius:0;\n    overflow:hidden;\n    background:\n      radial-gradient(120% 60% at 15% 8%, rgba(255,95,143,.28), transparent 55%),\n      radial-gradient(120% 70% at 85% 4%, rgba(106,58,143,.55), transparent 60%),\n      linear-gradient(190deg,var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);\n    display:flex;\n    flex-direction:column;\n  }\n  .stars{\n    position:absolute;\n    inset:0;\n    background-image:\n      radial-gradient(1.5px 1.5px at 20% 12%, rgba(255,255,255,.9), transparent),\n      radial-gradient(1.5px 1.5px at 68% 6%, rgba(255,255,255,.7), transparent),\n      radial-gradient(1px 1px at 82% 20%, rgba(255,255,255,.8), transparent),\n      radial-gradient(1.5px 1.5px at 10% 30%, rgba(255,255,255,.6), transparent),\n      radial-gradient(1px 1px at 40% 4%, rgba(255,255,255,.6), transparent),\n      radial-gradient(1.5px 1.5px at 92% 45%, rgba(255,255,255,.7), transparent),\n      radial-gradient(1px 1px at 55% 60%, rgba(255,255,255,.5), transparent),\n      radial-gradient(1.5px 1.5px at 25% 70%, rgba(255,255,255,.55), transparent),\n      radial-gradient(1px 1px at 75% 85%, rgba(255,255,255,.5), transparent);\n    pointer-events:none;\n  }\n  .status-bar{\n    position:relative;\n    z-index:2;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:16px 26px 4px;\n    color:var(--ink);\n    font-size:15px;\n    font-weight:600;\n    font-family:var(--font-ui);\n  }\n  .status-icons{display:flex;align-items:center;gap:6px;}\n  .notch{\n    position:absolute;\n    top:12px;left:50%;transform:translateX(-50%);\n    width:120px;height:26px;\n    background:#0e0e12;\n    border-radius:16px;\n    z-index:5;\n  }\n  .content{\n    position:relative;\n    z-index:2;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    padding:10px 20px 18px;\n    overflow:hidden;\n    gap:16px;\n  }\n  /* top row */\n  .top-row{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:10px;\n  }\n  .icon-btn{\n    width:38px;height:38px;\n    border-radius:50%;\n    background:rgba(255,255,255,.14);\n    display:flex;align-items:center;justify-content:center;\n    color:var(--ink);\n    flex:none;\n  }\n  .segmented{\n    flex:1;\n    display:flex;\n    background:rgba(255,255,255,.18);\n    border-radius:var(--radius-pill);\n    padding:4px;\n    max-width:230px;\n  }\n  .segmented span{\n    flex:1;\n    text-align:center;\n    padding:9px 6px;\n    border-radius:var(--radius-pill);\n    font-size:14.5px;\n    font-weight:600;\n    color:var(--ink-dim);\n  }\n  .segmented span.active{\n    background:var(--ink);\n    color:#241338;\n  }\n  /* avatar / companion */\n  .companion-wrap{\n    position:relative;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    margin-top:2px;\n  }\n  .halo{\n    position:relative;\n    width:230px;height:230px;\n    border-radius:50%;\n    background:radial-gradient(circle at 40% 35%, rgba(255,255,255,.55), rgba(255,255,255,0) 60%);\n    display:flex;align-items:center;justify-content:center;\n  }\n  .orb{\n    width:172px;height:172px;\n    border-radius:50%;\n    background:\n      radial-gradient(circle at 30% 28%, #ffe3b0 0%, transparent 34%),\n      conic-gradient(from 210deg at 55% 50%, #ffb15e 0deg, #ff7a59 90deg, #7d4fae 180deg, #3d2a63 260deg, #ffb15e 360deg);\n    box-shadow:0 0 60px 10px rgba(255,122,89,.35), inset -14px -18px 30px rgba(0,0,0,.35);\n    position:relative;\n    overflow:hidden;\n  }\n  .orb::after{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:radial-gradient(circle at 70% 65%, rgba(255,255,255,.18), transparent 45%);\n  }\n  .timer-chip{\n    position:absolute;\n    right:2px;\n    top:56%;\n    background:rgba(20,12,32,.78);\n    border-radius:20px;\n    padding:10px 14px 9px;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    gap:2px;\n    color:var(--ink);\n    font-weight:700;\n    font-size:13px;\n    box-shadow:0 8px 20px rgba(0,0,0,.35);\n  }\n  .companion-title{\n    font-family:var(--font-display);\n    font-size:52px;\n    color:var(--ink);\n    margin:6px 0 2px;\n    line-height:1;\n  }\n  .cta-btn{\n    margin-top:6px;\n    display:inline-flex;\n    align-items:center;\n    gap:10px;\n    background:linear-gradient(180deg,var(--coral),var(--coral-deep));\n    color:var(--ink);\n    border:none;\n    font-size:17px;\n    font-weight:700;\n    font-family:var(--font-ui);\n    padding:13px 26px;\n    border-radius:var(--radius-pill);\n    box-shadow:0 10px 22px rgba(255,122,89,.35);\n  }\n  /* next reading row */\n  .next-row{\n    display:flex;\n    justify-content:flex-end;\n    align-items:center;\n    gap:8px;\n    color:var(--ink-faint);\n    font-size:13px;\n    font-weight:600;\n  }\n  .locked-thumb{\n    width:44px;height:60px;\n    border-radius:10px;\n    background:linear-gradient(160deg,#4a2f6b,#8a4fae 40%, #3d5f8f 75%, #6ea86a);\n    position:relative;\n    box-shadow:0 6px 14px rgba(0,0,0,.35);\n  }\n  .locked-thumb .lock{\n    position:absolute;\n    top:-8px;right:-8px;\n    width:22px;height:22px;\n    border-radius:50%;\n    background:var(--ink);\n    display:flex;align-items:center;justify-content:center;\n    color:#241338;\n  }\n  .locked-thumb.small{width:34px;height:46px;border-radius:8px;}\n  .locked-thumb.small .lock{width:18px;height:18px;top:-6px;right:-6px;}\n  /* streak row */\n  .streak-row{\n    display:flex;\n    align-items:center;\n    gap:12px;\n  }\n  .streak-badge{\n    flex:none;\n    width:40px;height:40px;\n    border-radius:14px;\n    background:var(--mint);\n    color:#0d2418;\n    font-weight:800;\n    font-size:16px;\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:0 6px 14px rgba(79,212,138,.35);\n  }\n  .streak-track{\n    flex:1;\n    height:10px;\n    border-radius:var(--radius-pill);\n    background:var(--track);\n    overflow:hidden;\n  }\n  .streak-fill{\n    width:58%;\n    height:100%;\n    border-radius:var(--radius-pill);\n    background:linear-gradient(90deg,#4fd48a,#2fae7a);\n  }\n  /* feature card */\n  .feature-card{\n    position:relative;\n    background:linear-gradient(165deg,#241a3a,#180f28);\n    border-radius:var(--radius-lg);\n    padding:26px 20px 22px;\n    overflow:hidden;\n    text-align:center;\n    border:1px solid rgba(255,255,255,.06);\n  }\n  .feature-chat{\n    position:absolute;\n    top:18px;right:18px;\n    width:34px;height:34px;\n    border-radius:11px;\n    border:1.5px solid rgba(255,255,255,.5);\n    display:flex;align-items:center;justify-content:center;\n    color:var(--ink);\n  }\n  .feature-eyebrow{\n    color:var(--ink);\n    font-size:13px;\n    font-weight:700;\n    letter-spacing:.22em;\n    text-transform:uppercase;\n  }\n  .feature-rule{\n    width:34px;height:2px;\n    background:var(--ink);\n    margin:10px auto 16px;\n    opacity:.8;\n  }\n  .feature-heading{\n    font-family:var(--font-display);\n    font-size:26px;\n    line-height:1.25;\n    color:var(--ink);\n    margin:0 0 20px;\n    max-width:260px;\n    margin-left:auto;\n    margin-right:auto;\n  }\n  .constellation{\n    position:absolute;\n    left:14px;\n    bottom:14px;\n    width:110px;\n    height:90px;\n    opacity:.65;\n  }\n  .start-btn{\n    position:relative;\n    z-index:2;\n    background:var(--ink);\n    color:#1c1230;\n    border:none;\n    font-size:16px;\n    font-weight:700;\n    padding:11px 34px;\n    border-radius:var(--radius-pill);\n  }\n  /* activity row */\n  .activity-row{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    gap:10px;\n  }\n  .activity-card{\n    background:linear-gradient(165deg,#241a3a,#170e26);\n    border-radius:var(--radius-md);\n    padding:16px 12px 14px;\n    display:flex;\n    flex-direction:column;\n    justify-content:space-between;\n    min-height:104px;\n    border:1px solid rgba(255,255,255,.05);\n  }\n  .activity-icon{\n    width:26px;height:26px;\n  }\n  .activity-bottom{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:6px;\n  }\n  .activity-name{\n    color:var(--ink);\n    font-weight:700;\n    font-size:15px;\n  }\n  .ring{\n    width:30px;height:30px;\n    border-radius:50%;\n    display:flex;align-items:center;justify-content:center;\n    font-size:12px;\n    font-weight:700;\n    color:var(--ink);\n    flex:none;\n  }\n  .home-indicator{\n    position:absolute;\n    bottom:8px;left:50%;\n    transform:translateX(-50%);\n    width:134px;height:5px;\n    border-radius:3px;\n    background:rgba(255,255,255,.55);\n  }\n  @media (max-width:420px){\n    .companion-title{font-size:44px;}\n    .feature-heading{font-size:22px;}\n  }\n</style>\n\n<div class=\"page-wrap\" data-kid=\"2\">\n  <div class=\"brand-tag\" data-kid=\"3\">Solace &middot; daily companion</div>\n  <div class=\"phone\" data-kid=\"4\">\n    <div class=\"notch\" data-kid=\"5\"></div>\n    <div class=\"screen\" data-kid=\"6\">\n      <div class=\"stars\" data-kid=\"7\"></div>\n\n      <div class=\"status-bar\" data-kid=\"8\">\n        <span data-kid=\"9\">9:41</span>\n        <span class=\"status-icons\" data-kid=\"10\">\n          <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"none\" data-kid=\"11\"><rect x=\"0\" y=\"7\" width=\"3\" height=\"5\" rx=\"1\" fill=\"white\" data-kid=\"12\"></rect><rect x=\"5\" y=\"5\" width=\"3\" height=\"7\" rx=\"1\" fill=\"white\" data-kid=\"13\"></rect><rect x=\"10\" y=\"3\" width=\"3\" height=\"9\" rx=\"1\" fill=\"white\" data-kid=\"14\"></