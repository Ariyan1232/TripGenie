  "nodes": {
    "var_1898332fef8c": {
      "type": "variant",
      "label": "Wild Canopy (Organic)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<div class=\"w-[375px] bg-[#FADFAD] min-h-screen font-['Cabin'] text-[#568203] overflow-x-clip relative pb-48\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;700&family=Cabin:wght@400;600&display=swap');\n    @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n    .font-heading { font-family: 'Fraunces', serif; }\n    .font-body { font-family: 'Cabin', sans-serif; }\n\n    /* Patterns */\n    .shape-blob { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }\n    .shape-blob-alt { border-radius: 30% 70% 70% 30% / 50% 30% 70% 50%; }\n    .shape-leaf { border-radius: 5% 50% 50% 50%; }\n    .glass { background: rgba(255, 255, 255, 0.45); backdrop-filter: blur(12px); border: 1px solid rgba(86, 130, 3, 0.1); box-shadow: 0 8px 32px rgba(86, 130, 3, 0.05); }\n    .scalloped { mask-image: radial-gradient(circle at 12px 100%, transparent 12px, white 12px); mask-size: 24px 100%; mask-repeat: repeat-x; }\n\n    .no-scrollbar::-webkit-scrollbar { display: none; }\n    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n    /* Background Blobs */\n    .bg-blob { position: absolute; filter: blur(60px); z-index: 0; opacity: 0.25; }\n\n    /* Droplet Clip Path */\n    .droplet-v2 { clip-path: url(#droplet-path); }\n\n    /* Animation Classes */\n    .float-slow { animation: floatSlow 6s ease-in-out infinite; }\n    @keyframes floatSlow { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-12px) rotate(2deg); } }\n  </style>\n\n  <!-- Shared ClipPaths -->\n  <svg width=\"0\" height=\"0\" class=\"absolute\">\n    <defs>\n      <clipPath id=\"droplet-path\" clipPathUnits=\"objectBoundingBox\">\n        <path d=\"M0.5,0 C0.5,0 1,0.5 1,0.75 C1,0.888 0.776,1 0.5,1 C0.224,1 0,0.888 0,0.75 C0,0.5 0.5,0 0.5,0 Z\" />\n      </clipPath>\n    </defs>\n  </svg>\n\n  <!-- Background Decorative Blobs -->\n  <div class=\"bg-blob w-64 h-64 bg-[#9966CC] top-[-50px] left-[-50px] shape-blob\"></div>\n  <div class=\"bg-blob w-80 h-80 bg-[#568203] top-[400px] right-[-100px] shape-blob\"></div>\n  <div class=\"bg-blob w-72 h-72 bg-[#9966CC] bottom-[200px] left-[-100px] shape-blob\"></div>\n\n  <!-- Header -->\n  <nav class=\"relative z-10 pt-8 px-6 flex justify-between items-center mb-8\">\n    <div class=\"flex items-center gap-3\">\n      <div class=\"w-12 h-12 bg-[#568203] shape-leaf flex items-center justify-center shadow-lg\">\n        <i class=\"ti ti-ripple text-white text-2xl\"></i>\n      </div>\n      <div>\n        <h1 class=\"font-heading text-2xl font-bold leading-none\">Wild Canopy</h1>\n        <p class=\"text-[10px] uppercase tracking-widest text-[#568203]/60 font-bold mt-1\">Organic Travels</p>\n      </div>\n    </div>\n    <div class=\"w-12 h-12 glass rounded-2xl flex items-center justify-center text-[#568203] shadow-md border-white/40\">\n      <i class=\"ti ti-search text-xl\"></i>\n    </div>\n  </nav>\n\n  <!-- #story-reel-bar -->\n  <section class=\"relative z-10 mb-12\">\n    <div class=\"flex gap-6 overflow-x-auto px-6 no-scrollbar pb-4 items-end\">\n      <div class=\"flex flex-col items-center shrink-0\">\n        <div class=\"w-20 h-24 bg-[#568203] p-[3px] droplet-v2 shadow-xl ring-2 ring-[#568203]/20 ring-offset-4 ring-offset-[#FADFAD]\">\n          <img src=\"https://i.pravatar.cc/100?u=me\" class=\"w-full h-full object-cover droplet-v2\" alt=\"Me\" />\n        </div>\n        <span class=\"text-[10px] font-bold mt-3 text-[#568203]\">YOUR STORY</span>\n      </div>\n      <div class=\"flex flex-col items-center shrink-0 ambient-float\" style=\"animation-delay: 0.1s\">\n        <div class=\"w-16 h-20 bg-[#9966CC] p-[2px] droplet-v2 shadow-lg\">\n           <img src=\"https://i.pravatar.cc/100?u=alex\" class=\"w-full h-full object-cover droplet-v2\" alt=\"Alex\" />\n        </div>\n        <span class=\"text-[10px] font-bold mt-3 opacity-60\">ALEX</span>\n      </div>\n      <div class=\"flex flex-col items-center shrink-0 ambient-float\" style=\"animation-delay: 0.3s\">\n        <div class=\"w-16 h-20 bg-[#568203] p-[2px] droplet-v2 shadow-lg\">\n           <img src=\"https://i.pravatar.cc/100?u=sam\" class=\"w-full h-full object-cover droplet-v2\" alt=\"Sam\" />\n        </div>\n        <span class=\"text-[10px] font-bold mt-3 opacity-60\">SAM</span>\n      </div>\n      <div class=\"flex flex-col items-center shrink-0 ambient-float\" style=\"animation-delay: 0.5s\">\n        <div class=\"w-16 h-20 bg-[#9966CC] p-[2px] droplet-v2 shadow-lg opacity-80\">\n           <img src=\"https://i.pravatar.cc/100?u=jo\" class=\"w-full h-full object-cover droplet-v2\" alt=\"Jo\" />\n        </div>\n        <span class=\"text-[10px] font-bold mt-3 opacity-60\">JO</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- Fluid Discovery Carousel -->\n  <section class=\"relative z-10 mb-16\">\n    <div class=\"px-6 flex justify-between items-baseline mb-8\">\n      <h2 class=\"font-heading text-4xl leading-tight\">Flowing<br/>Discoveries</h2>\n      <div class=\"w-10 h-10 glass rounded-full flex items-center justify-center text-[#568203]\">\n        <i class=\"ti ti-arrow-narrow-right text-xl\"></i>\n      </div>\n    </div>\n    \n    <div class=\"flex gap-8 overflow-x-auto px-6 no-scrollbar snap-x\">\n      <div class=\"shrink-0 w-80 h-[480px] relative overflow-hidden shape-blob-alt snap-center reveal-mask border-8 border-white shadow-2xl\">\n        <video \n          src=\"https://videos.pexels.com/video-files/14615843/14615842_640_360_24fps.mp4\" \n          poster=\"https://images.pexels.com/videos/14615843/aerial-banjul-drone-the-gambia-14615843.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\"\n          class=\"absolute inset-0 w-full h-full object-cover\"\n          autoplay muted loop playsinline\n        ></video>\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent\"></div>\n        <div class=\"absolute bottom-0 left-0 p-10 w-full\">\n          <p class=\"text-[10px] text-[#FADFAD]/60 font-bold tracking-[0.3em] mb-3 uppercase\">South America</p>\n          <p class=\"text-white font-heading text-4xl mb-2\">Amazonas</p>\n          <button class=\"mt-6 px-6 py-3 bg-[#568203] text-white text-xs font-bold rounded-full shadow-lg flex items-center gap-2\">\n            Explore Path <i class=\"ti ti-chevron-right\"></i>\n          </button>\n        </div>\n      </div>\n      <div class=\"shrink-0 w-80 h-[480px] relative overflow-hidden shape-blob snap-center reveal-mask border-8 border-white shadow-2xl\">\n        <img \n          src=\"https://images.unsplash.com/photo-1769275704906-c2071d01805d?auto=format&w=800&q=80&fit=crop\" \n          class=\"absolute inset-0 w-full h-full object-cover\"\n          alt=\"Misty mountain\"\n        />\n        <div class=\"absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent\"></div>\n        <div class=\"absolute bottom-0 left-0 p-10 w-full\">\n          <p class=\"text-[10px] text-[#FADFAD]/60 font-bold tracking-[0.3em] mb-3 uppercase\">Asia</p>\n          <p class=\"text-white font-heading text-4xl mb-2\">Cloud Peaks</p>\n          <button class=\"mt-6 px-6 py-3 bg-[#9966CC] text-white text-xs font-bold rounded-full shadow-lg flex items-center gap-2\">\n            Explore Path <i class=\"ti ti-chevron-right\"></i>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Freeform Canvas (Planning Board) -->\n  <section class=\"relative z-10 px-6 mb-24 overflow-visible\">\n    <div class=\"mb-10 flex flex-col items-start gap-4\">\n      <div class=\"flex items-center gap-4\">\n        <h2 class=\"font-heading text-4xl\">Wild Canvas</h2>\n        <div class=\"px-3 py-1 bg-[#9966CC] text-white text-[9px] font-bold rounded-full animate-pulse\">LIVE</div>\n      </div>\n      <div class=\"flex -space-x-4\">\n        <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-12 h-12 rounded-full border-4 border-[#FADFAD] shadow-lg\" />\n        <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-12 h-12 rounded-full border-4 border-[#FADFAD] shadow-lg\" />\n        <div class=\"w-12 h-12 rounded-full border-4 border-[#FADFAD] bg-[#568203] flex items-center justify-center text-white text-xs font-bold shadow-lg\">+4</div>\n      </div>\n    </div>\n\n    <!-- Freeform Interaction Area -->\n    <div class=\"h-[650px] relative\">\n      <!-- Main Visual -->\n      <div class=\"absolute top-0 left-0 w-full h-[320px] shape-leaf overflow-hidden shadow-2xl border-4 border-white rotate-[-2deg] reveal-scale\">\n        <img src=\"https://images.unsplash.com/photo-1762487995640-9d2c397c7aa0?auto=format&w=800&q=80&fit=crop\" class=\"w-full h-full object-cover\" />\n      </div>\n\n      <!-- Overlapping Note -->\n      <div class=\"absolute top-[260px] right-2 w-48 glass shape-blob p-6 shadow-2xl rotate-[3deg] reveal-scale float-slow\">\n        <div class=\"flex justify-between items-center mb-4\">\n          <i class=\"ti ti-sparkles text-[#9966CC] text-xl\"></i>\n          <span class=\"text-[9px] font-bold text-[#568203]\">ALEX'S IDEA</span>\n        </div>\n        <p class=\"font-heading text-lg leading-tight mb-4\">Pack lightweight hiking gear for the rainforest treks.</p>\n        <div class=\"flex -space-x-1\">\n          <div class=\"w-6 h-6 rounded-full bg-[#568203] border-2 border-white\"></div>\n          <div class=\"w-6 h-6 rounded-full bg-[#9966CC] border-2 border-white\"></div>\n        </div>\n      </div>\n\n      <!-- Budget Scalloped Card (Small) -->\n      <div class=\"absolute top-[420px] left-0 w-52 bg-[#568203] text-[#FADFAD] shape-leaf p-8 shadow-2xl rotate-[-4deg] reveal-scale\">\n        <p class=\"text-[10px] uppercase font-bold tracking-widest opacity-60 mb-2\">Total Pooled</p>\n        <p class=\"text-3xl font-heading mb-4 leading-none\">$12,480</p>\n        <div class=\"h-[1px] bg-white/10 w-full my-4\"></div>\n        <div class=\"flex justify-between items-center\">\n          <span class=\"text-[9px] font-bold\">REMAINING</span>\n          <span class=\"text-sm font-bold\">$4,250</span>\n        </div>\n      </div>\n\n      <!-- Floating Collaborator Tag -->\n      <div class=\"absolute top-[100px] right-[20px] z-20 ambient-float flex flex-col items-center\">\n        <div class=\"bg-[#9966CC] text-white px-3 py-1.5 rounded-full text-[10px] font-bold shadow-xl border-2 border-white flex items-center gap-2\">\n          <i class=\"ti ti-cursor-text\"></i> Sam is typing...\n        </div>\n        <div class=\"w-4 h-4 bg-[#9966CC] rotate-45 -mt-2 border-r-2 border-b-2 border-white\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Shared Timeline (S-Curve) -->\n  <section class=\"relative z-10 mb-32\">\n    <div class=\"px-6 mb-16\">\n      <h2 class=\"font-heading text-4xl leading-tight\">Winding<br/>Itinerary</h2>\n    </div>\n\n    <!-- S-Curve Path Overlay -->\n    <div class=\"absolute left-1/2 -translate-x-1/2 top-48 w-full h-[800px] pointer-events-none overflow-visible\">\n      <svg class=\"w-full h-full\" viewBox=\"0 0 100 800\" preserveAspectRatio=\"none\">\n        <path id=\"itinerary-path\" d=\"M30,0 C80,100 20,200 70,300 C120,400 30,500 50,650 C70,800 50,800 50,800\" fill=\"none\" stroke=\"#568203\" stroke-width=\"3\" stroke-dasharray=\"10 6\" opacity=\"0.3\" />\n        <circle id=\"itinerary-dot\" r=\"6\" fill=\"#568203\" />\n      </svg>\n    </div>\n\n    <!-- Timeline Cards -->\n    <div class=\"space-y-32 relative px-6\">\n      <!-- Item 1 -->\n      <div class=\"flex justify-start\">\n        <div class=\"w-64 glass shape-leaf p-8 shadow-2xl relative timeline-item border-2 border-white\">\n          <div class=\"absolute -right-6 -top-6 w-14 h-14 bg-[#568203] text-white rounded-full flex flex-col items-center justify-center font-bold border-4 border-[#FADFAD] shadow-xl\">\n            <span class=\"text-[8px] leading-none opacity-60\">DAY</span>\n            <span class=\"text-lg leading-none\">01</span>\n          </div>\n          <p class=\"text-[10px] font-bold text-[#9966CC] mb-2 uppercase tracking-widest\">Arrival</p>\n          <h3 class=\"font-heading text-2xl mb-4 leading-tight\">Canopy Check-in</h3>\n          <p class=\"text-xs text-gray-600 leading-relaxed\">Settle into your hanging biomorphic pod and meet the group for a sunset welcome drink.</p>\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"flex justify-end\">\n        <div class=\"w-64 glass shape-blob p-8 shadow-2xl relative timeline-item border-2 border-white\">\n          <div class=\"absolute -left-6 -top-6 w-14 h-14 bg-[#9966CC] text-white rounded-full flex flex-col items-center justify-center font-bold border-4 border-[#FADFAD] shadow-xl\">\n             <span class=\"text-[8px] leading-none opacity-60\">DAY</span>\n             <span class=\"text-lg leading-none\">02</span>\n          </div>\n          <p class=\"text-[10px] font-bold text-[#568203] mb-2 uppercase tracking-widest\">Adventure</p>\n          <h3 class=\"font-heading text-2xl mb-4 leading-tight\">Mist Trek</h3>\n          <p class=\"text-xs text-gray-600 leading-relaxed\">A guided meditation trek through the high-altitude cloud forest with local naturalists.</p>\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"flex justify-start\">\n        <div class=\"w-64 glass shape-leaf p-8 shadow-2xl relative timeline-item border-2 border-white\">\n          <div class=\"absolute -right-6 -top-6 w-14 h-14 bg-[#568203] text-white rounded-full flex flex-col items-center justify-center font-bold border-4 border-[#FADFAD] shadow-xl\">\n             <span class=\"text-[8px] leading-none opacity-60\">DAY</span>\n             <span class=\"text-lg leading-none\">03</span>\n          </div>\n          <p class=\"text-[10px] font-bold text-[#9966CC] mb-2 uppercase tracking-widest\">Riverside</p>\n          <h3 class=\"font-heading text-2xl mb-4 leading-tight\">Bamboo Rafting</h3>\n          <p class=\"text-xs text-gray-600 leading-relaxed\">Navigate the winding Amazonas tributaries followed by a local organic harvest lunch.</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Bottom Navigation (Organic Pill) -->\n  <div class=\"fixed bottom-8 left-1/2 -translate-x-1/2 w-[340px] z-50\">\n    <div class=\"bg-[#568203] text-white h-20 rounded-[40px] shadow-2xl flex items-center justify-between px-4 border border-white/20 relative\">\n      <button class=\"w-14 h-14 rounded-full flex items-center justify-center bg-white/10 hover:bg-white/20 transition-colors\">\n        <i class=\"ti ti-home-2 text-2xl\"></i>\n      </button>\n      <button class=\"w-14 h-14 rounded-full flex items-center justify-center text-white/50\">\n        <i class=\"ti ti-map-2 text-2xl\"></i>\n      </button>\n      <!-- Center Action -->\n      <div class=\"absolute -top-10 left-1/2 -translate-x-1/2\">\n        <button class=\"w-20 h-20 bg-[#9966CC] text-white rounded-[40%] rotate-[15deg] flex items-center justify-center shadow-2xl border-4 border-[#FADFAD] hover:rotate-[45deg] transition-all duration-500\">\n          <i class=\"ti ti-sparkles text-3xl -rotate-[15deg]\"></i>\n        </button>\n      </div>\n      <button class=\"w-14 h-14 rounded-full flex items-center justify-center text-white/50\">\n        <i class=\"ti ti-message-2 text-2xl\"></i>\n      </button>\n      <button class=\"w-14 h-14 rounded-full flex items-center justify-center text-white/50\">\n        <i class=\"ti ti-dots-vertical text-2xl\"></i>\n      </button>\n    </div>\n  </div>\n\n  <!-- Scripts -->\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/MotionPathPlugin.min.js\"></script>\n  <script>\n    gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);\n\n    // #anime-ambient-float\n    gsap.to(\".ambient-float\", {\n      y: -8,\n      duration: 2,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\",\n      stagger: {\n        each: 0.2,\n        from: \"start\"\n      }\n    });\n\n    // #gsap-mask-wipe style entrances\n    gsap.from(\".reveal-mask\", {\n      scrollTrigger: {\n        trigger: \".reveal-mask\",\n        start: \"top 90%\",\n      },\n      clipPath: \"inset(0 100% 0 0)\",\n      duration: 1.2,\n      ease: \"power3.out\",\n      stagger: 0.2\n    });\n\n    // Scale entrances for bento\n    gsap.from(\".reveal-scale\", {\n      scrollTrigger: {\n        trigger: \".reveal-scale\",\n        start: \"top 90%\",\n      },\n      scale: 0.8,\n      opacity: 0,\n      duration: 1,\n      ease: \"back.out(1.7)\",\n      stagger: 0.15\n    });\n\n    // #motion-svg-effect-draw-loop for Itinerary\n    const path = document.querySelector(\"#itinerary-path\");\n    const pathLength = path.getTotalLength();\n    gsap.set(path, { strokeDasharray: pathLength, strokeDashoffset: pathLength });\n    \n    gsap.to(path, {\n      strokeDashoffset: 0,\n      duration: 2,\n      ease: \"none\",\n      scrollTrigger: {\n        trigger: path,\n        start: \"top 80%\",\n        end: \"bottom 20%\",\n        scrub: 1.5\n      }\n    });\n\n    // Animate the dot along the path\n    gsap.to(\"#itinerary-dot\", {\n      motionPath: {\n        path: \"#itinerary-path\",\n        align: \"#itinerary-path\",\n        alignOrigin: [0.5, 0.5]\n      },\n      scrollTrigger: {\n        trigger: path,\n        start: \"top 80%\",\n        end: \"bottom 20%\",\n        scrub: 1\n      }\n    });\n\n    // Timeline item reveals\n    gsap.from(\".timeline-item\", {\n      scrollTrigger: {\n        trigger: \".timeline-item\",\n        start: \"top 90%\",\n      },\n      x: (i) => i % 2 === 0 ? 50 : -50,\n      opacity: 0,\n      duration: 1,\n      ease: \"power2.out\",\n      stagger: 0.3\n    });\n\n  </script>\n</div>\n",
      "comments": [],
      "created": "2026-07-23T02:49:38.334526+00:00",
      "modified": "2026-07-23T02:49:38.334526+00:00",
      "id": "var_1898332fef8c"
    },
    "var_792211a35b4b": {
      "type": "variant",
      "label": "Aqua Explorer (Y2K Glass)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 475,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Urbanist:wght@700;800&family=Kumbh+Sans:wght@400;500;600&display=swap');\n\n  :root {\n    --deep-ocean: #007A74;\n    --pearl-aqua: #81D8D0;\n    --vibrant-coral: #FE6F5E;\n    --glass-bg: rgba(255, 255, 255, 0.45);\n    --glass-border: rgba(255, 255, 255, 0.3);\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    font-family: 'Kumbh Sans', sans-serif;\n    background-color: #f0f7f6;\n    color: var(--deep-ocean);\n  }\n\n  .font-urbanist { font-family: 'Urbanist', sans-serif; }\n  .font-kumbh { font-family: 'Kumbh Sans', sans-serif; }\n\n  /* Hide scrollbars but keep functionality */\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Glassmorphism utility */\n  .glass {\n    background: var(--glass-bg);\n    backdrop-filter: blur(16px);\n    -webkit-backdrop-filter: blur(16px);\n    border: 1px solid var(--glass-border);\n    box-shadow: 0 8px 32px 0 rgba(0, 122, 116, 0.1);\n  }\n\n  .glass-highlight {\n    position: relative;\n  }\n  .glass-highlight::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);\n  }\n\n  /* Polaroid shape */\n  .polaroid {\n    background: white;\n    padding: 12px 12px 28px 12px;\n    box-shadow: 0 12px 35px rgba(0,0,0,0.1);\n    transform: rotate(var(--rotation, 0deg));\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n  }\n\n  /* Custom shapes from requirement */\n  .map-pin {\n    border-radius: 50% 50% 50% 50% / 70% 70% 30% 30%;\n  }\n\n  <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\">\n  /* Lenis required */\n  html.lenis {\n    height: auto;\n  }\n  .lenis.lenis-smooth {\n    scroll-behavior: auto;\n  }\n  .lenis.lenis-smooth [data-lenis-prevent] {\n    overscroll-behavior: contain;\n  }\n  .lenis.lenis-stopped {\n    overflow: hidden;\n  }\n</style>\n\n<div id=\"main-content\" class=\"relative pb-24\">\n  \n  <!-- Section 1: Discovery Hero (Parallax) -->\n  <section id=\"hero\" class=\"relative h-[85vh] w-full overflow-hidden\">\n    <!-- Parallax Image Layer -->\n    <div id=\"hero-parallax-container\" class=\"absolute inset-0 w-full h-[120%] -top-[10%]\">\n      <img src=\"https://images.unsplash.com/photo-1710104434425-6ae10f736622?auto=format&w=1200&q=80&fit=crop\" \n           alt=\"Tropical Islands Aerial View\" \n           class=\"w-full h-full object-cover brightness-105\"\n           id=\"hero-image\"\n           decoding=\"async\" loading=\"lazy\">\n    </div>\n\n    <!-- Top Navigation Overlay -->\n    <div class=\"absolute top-0 left-0 right-0 z-20 px-6 pt-12 flex justify-between items-center\">\n      <div class=\"glass p-2.5 rounded-2xl\">\n        <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h7\"/></svg>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <div class=\"glass px-4 py-2 rounded-2xl flex items-center gap-2\">\n          <div class=\"w-2 h-2 rounded-full bg-green-400 animate-pulse\"></div>\n          <span class=\"text-xs font-bold text-white font-urbanist\">Live Group</span>\n        </div>\n        <img src=\"https://i.pravatar.cc/40?u=main\" class=\"w-10 h-10 rounded-2xl border-2 border-white/50 object-cover shadow-lg\" alt=\"User Profile\">\n      </div>\n    </div>\n\n    <!-- Frosted Glass Content Panel (#parallax-hero-scroll pattern) -->\n    <div class=\"absolute bottom-0 left-0 right-0 z-10 px-4 pb-4\">\n      <div class=\"glass rounded-[40px] p-8 glass-highlight\" id=\"hero-content\">\n        <div class=\"w-12 h-1.5 bg-white/40 rounded-full mx-auto mb-6\"></div>\n        <div class=\"mb-2 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 border border-white/30 backdrop-blur-sm\">\n          <span class=\"text-[10px] font-bold text-white uppercase tracking-widest font-urbanist\">Next Destination</span>\n        </div>\n        <h1 class=\"font-urbanist text-4xl font-extrabold text-white leading-[1.1] mb-4\">\n          Aqua <span class=\"text-white/70\">Explorer</span> <br/>\n          <span class=\"text-white\">Paradise Found.</span>\n        </h1>\n        <p class=\"font-kumbh text-white/90 text-sm leading-relaxed mb-8 max-w-[85%]\">\n          Design, vote, and book your next tropical getaway with your favorite people. Seamless collaborative planning.\n        </p>\n        \n        <div class=\"flex items-center gap-4\">\n          <button id=\"start-btn\" class=\"flex-1 bg-[var(--vibrant-coral)] text-white font-urbanist font-extrabold py-4 px-6 rounded-2xl shadow-[0_10px_30px_rgba(254,111,94,0.4)] active:scale-95 flex justify-center items-center gap-2\">\n            START PLANNING\n            <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"/></svg>\n          </button>\n          <button class=\"w-14 h-14 glass flex items-center justify-center rounded-2xl active:scale-90\">\n             <svg class=\"w-6 h-6 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z\"/></svg>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section 2: Discovery Feed (#motion-horizontal-mixed-width) -->\n  <section class=\"pt-20 pb-12 bg-white/30\">\n    <div class=\"px-6 mb-8 flex justify-between items-end\">\n      <div>\n        <h2 class=\"font-urbanist text-2xl font-bold tracking-tight\">Discovery Feed</h2>\n        <p class=\"font-kumbh text-xs text-[#007A74]/60 font-medium\">Trending collaborative trips</p>\n      </div>\n      <div class=\"flex gap-2\">\n         <div class=\"w-8 h-8 rounded-full border border-[var(--pearl-aqua)] flex items-center justify-center text-[var(--deep-ocean)]\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 19l-7-7 7-7\"/></svg>\n         </div>\n         <div class=\"w-8 h-8 rounded-full bg-[var(--pearl-aqua)] flex items-center justify-center text-white\">\n            <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 5l7 7-7 7\"/></svg>\n         </div>\n      </div>\n    </div>\n\n    <!-- Mixed Width Horizontal Strip -->\n    <div class=\"flex overflow-x-auto gap-6 px-6 no-scrollbar snap-x snap-mandatory hscroll-track\">\n      <!-- Card 1: Wide -->\n      <div class=\"min-w-[78vw] snap-start h-80 rounded-[32px] overflow-hidden relative group\" id=\"trip-card-1\">\n        <img src=\"https://images.unsplash.com/photo-1771533679902-bf7ac6fa4078?auto=format&w=800&q=80&fit=crop\" alt=\"Bali\" class=\"w-full h-full object-cover\">\n        <div class=\"absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent\"></div>\n        <div class=\"absolute top-5 left-5 right-5 flex justify-between items-start\">\n           <div class=\"glass px-3 py-1 rounded-full border border-white/40\">\n              <span class=\"text-[10px] font-bold text-white font-urbanist uppercase\">Popular</span>\n           </div>\n           <div class=\"w-10 h-10 rounded-full glass border border-white/40 flex items-center justify-center text-white\">\n              <svg class=\"w-5 h-5\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n           </div>\n        </div>\n        <div class=\"absolute bottom-6 left-6 right-6\">\n           <div class=\"flex items-center gap-2 mb-2\">\n              <div class=\"flex -space-x-3\">\n                 <img src=\"https://i.pravatar.cc/40?u=a\" class=\"w-8 h-8 rounded-full border-2 border-white shadow-sm\">\n                 <img src=\"https://i.pravatar.cc/40?u=b\" class=\"w-8 h-8 rounded-full border-2 border-white shadow-sm\">\n                 <div class=\"w-8 h-8 rounded-full bg-[var(--pearl-aqua)] border-2 border-white shadow-sm flex items-center justify-center text-[8px] font-bold text-white\">+4</div>\n              </div>\n              <span class=\"text-white/80 text-[10px] font-semibold font-kumbh\">Friends are planning</span>\n           </div>\n           <h3 class=\"font-urbanist text-2xl font-extrabold text-white\">The Bali Blue Expedition</h3>\n        </div>\n        <div class=\"absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent\"></div>\n      </div>\n\n      <!-- Card 2: Narrower -->\n      <div class=\"min-w-[55vw] snap-start h-80 rounded-[32px] overflow-hidden relative\" id=\"trip-card-2\">\n        <img src=\"https://images.unsplash.com/photo-1758782551926-54ae07c5b0e3?auto=format&w=600&q=80&fit=crop\" alt=\"Phi Phi\" class=\"w-full h-full object-cover\">\n        <div class=\"absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-transparent\"></div>\n        <div class=\"absolute bottom-6 left-6 right-6\">\n           <h3 class=\"font-urbanist text-xl font-bold text-white\">Phi Phi Islands</h3>\n           <p class=\"text-white/60 text-[10px] font-kumbh uppercase tracking-wide\">3 days left to vote</p>\n        </div>\n        <div class=\"absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent\"></div>\n      </div>\n\n      <!-- Card 3: Medium -->\n      <div class=\"min-w-[65vw] snap-start h-80 rounded-[32px] overflow-hidden relative\" id=\"trip-card-3\">\n        <img src=\"https://images.unsplash.com/photo-1780552362702-6e7ce64bdcf7?auto=format&w=600&q=80&fit=crop\" alt=\"Sandbar\" class=\"w-full h-full object-cover\">\n        <div class=\"absolute inset-0 bg-linear-to-t from-black/70 via-transparent to-transparent\"></div>\n        <div class=\"absolute bottom-6 left-6 right-6\">\n           <h3 class=\"font-urbanist text-xl font-bold text-white\">White Sand Safari</h3>\n           <p class=\"text-white/60 text-[10px] font-kumbh uppercase tracking-wide\">Active Discussion</p>\n        </div>\n        <div class=\"absolute top-0 left-0 right-0 h-px bg-linear-to-r from-transparent via-white/50 to-transparent\"></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Section 3: Trip Board (Collaborative) -->\n  <section class=\"py-12 px-6\">\n    <div class=\"mb-10 text-center\">\n      <h2 class=\"font-urbanist text-2xl font-bold\">Group Trip Board</h2>\n      <p class=\"font-kumbh text-sm text-[#007A74]/60\">Collaborative ideas for Tokyo 2024</p>\n    </div>\n\n    <!-- Polaroid Layout Grid -->\n    <div class=\"grid grid-cols-2 gap-x-6 gap-y-12\">\n      <!-- Item 1 -->\n      <div class=\"relative pt-6 trip-item\" style=\"--rotation: -2deg;\">\n        <div class=\"absolute -top-1 left-1/2 -translate-x-1/2 w-16 h-6 bg-[rgba(254,111,94,0.35)] -rotate-[4deg] z-10 border border-white/10 backdrop-blur-[2px]\"></div>\n        <div class=\"polaroid\">\n          <div class=\"aspect-square bg-gray-100 overflow-hidden mb-4 rounded-xs\">\n            <img src=\"https://images.unsplash.com/photo-1570365473297-4a454f76ff0e?auto=format&w=400&q=80&fit=crop\" alt=\"Tokyo Street Food\" class=\"w-full h-full object-cover\">\n          </div>\n          <p class=\"font-urbanist text-[13px] font-bold text-gray-800 leading-tight\">Shinjuku Food Tour</p>\n          <div class=\"mt-2 flex items-center justify-between\">\n            <div class=\"flex items-center gap-1.5\">\n               <img src=\"https://i.pravatar.cc/40?u=sarah\" class=\"w-5 h-5 rounded-full\">\n               <span class=\"text-[9px] font-medium text-gray-500\">Sarah</span>\n            </div>\n            <span class=\"text-[9px] font-bold text-[var(--vibrant-coral)] bg-[var(--vibrant-coral)]/10 px-1.5 rounded\">9.2</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Item 2 -->\n      <div class=\"relative pt-6 trip-item\" style=\"--rotation: 3deg;\">\n        <div class=\"absolute -top-1 left-1/2 -translate-x-1/2 w-16 h-6 bg-[rgba(129,216,208,0.4)] rotate-[2deg] z-10 border border-white/10 backdrop-blur-[2px]\"></div>\n        <div class=\"polaroid\">\n          <div class=\"aspect-square bg-gray-100 overflow-hidden mb-4 rounded-xs\">\n            <img src=\"https://images.pexels.com/photos/18911914/pexels-photo-18911914.jpeg?auto=compress&cs=tinysrgb&w=400&q=80\" alt=\"Market\" class=\"w-full h-full object-cover\">\n          </div>\n          <p class=\"font-urbanist text-[13px] font-bold text-gray-800 leading-tight\">Neon Night Market</p>\n          <div class=\"mt-2 flex items-center justify-between\">\n            <div class=\"flex items-center gap-1.5\">\n               <img src=\"https://i.pravatar.cc/40?u=mike\" class=\"w-5 h-5 rounded-full\">\n               <span class=\"text-[9px] font-medium text-gray-500\">Mike</span>\n            </div>\n            <span class=\"text-[9px] font-bold text-[var(--pearl-aqua)] bg-[var(--pearl-aqua)]/20 px-1.5 rounded\">8.8</span>\n          </div>\n        </div>\n      </div>\n\n       <!-- Item 3 -->\n       <div class=\"relative pt-6 trip-item\" style=\"--rotation: 1deg;\">\n        <div class=\"absolute -top-1 left-1/2 -translate-x-1/2 w-16 h-6 bg-[rgba(0,122,116,0.2)] -rotate-[1deg] z-10 border border-white/10 backdrop-blur-[2px]\"></div>\n        <div class=\"polaroid\">\n          <div class=\"aspect-square bg-gray-100 overflow-hidden mb-4 rounded-xs\">\n            <img src=\"https://images.unsplash.com/photo-1718942900361-d01a1ee8d077?auto=format&w=400&q=80&fit=crop\" alt=\"Temples\" class=\"w-full h-full object-cover\">\n          </div>\n          <p class=\"font-urbanist text-[13px] font-bold text-gray-800 leading-tight\">Kyoto Day Trip</p>\n          <div class=\"mt-2 flex items-center justify-between\">\n            <div class=\"flex items-center gap-1.5\">\n               <img src=\"https://i.pravatar.cc/40?u=leo\" class=\"w-5 h-5 rounded-full\">\n               <span class=\"text-[9px] font-medium text-gray-500\">Leo</span>\n            </div>\n            <span class=\"text-[9px] font-bold text-gray-400 bg-gray-100 px-1.5 rounded\">TBD</span>\n          </div>\n        </div>\n      </div>\n\n      <!-- Add New Idea Card -->\n      <div class=\"relative pt-6 h-full min-h-[220px]\">\n        <div class=\"polaroid flex flex-col items-center justify-center border-2 border-dashed border-[var(--pearl-aqua)] bg-transparent shadow-none group cursor-pointer active:scale-95 transition-transform h-full w-full\">\n          <div class=\"w-12 h-12 rounded-2xl bg-[var(--pearl-aqua)]/20 flex items-center justify-center text-[var(--pearl-aqua)] mb-3 group-hover:bg-[var(--pearl-aqua)] group-hover:text-white transition-colors duration-300\">\n             <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M12 4v16m8-8H4\"/></svg>\n          </div>\n          <p class=\"font-urbanist text-xs font-bold text-[var(--pearl-aqua)]\">Add Idea</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Collaborative Toast Layer -->\n  <div id=\"toast-container\" class=\"fixed top-24 right-0 z-50 pointer-events-none px-4\">\n    <div id=\"collab-toast\" class=\"glass border-l-4 border-l-[var(--vibrant-coral)] p-4 rounded-2xl shadow-xl flex items-center gap-4 min-w-[280px] pointer-events-auto opacity-0\">\n      <div class=\"relative\">\n        <img src=\"https://i.pravatar.cc/40?u=sarah\" class=\"w-10 h-10 rounded-full border-2 border-[var(--vibrant-coral)]\">\n        <div class=\"absolute -bottom-1 -right-1 w-4 h-4 bg-[var(--vibrant-coral)] rounded-full flex items-center justify-center border-2 border-white\">\n           <svg class=\"w-2 h-2 text-white\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M12 2l2.4 7.2h7.6l-6.1 4.5 2.3 7.3-6.2-4.5-6.2 4.5 2.3-7.3-6.1-4.5h7.6z\"/></svg>\n        </div>\n      </div>\n      <div>\n        <p class=\"text-[13px] font-bold leading-none mb-1 text-[var(--deep-ocean)]\">Sarah updated flights</p>\n        <p class=\"text-[10px] text-gray-500 font-medium\">Just now • Team Alpha</p>\n      </div>\n    </div>\n  </div>\n\n  <!-- Bottom Nav Bar (#bottom-tab-bar) -->\n  <nav class=\"fixed bottom-0 left-0 right-0 z-50 px-6 pb-6 pointer-events-none\">\n    <div class=\"pointer-events-auto glass rounded-[32px] border border-white/40 p-2 flex justify-between items-center shadow-[0_-10px_50px_rgba(0,122,116,0.2)] max-w-md mx-auto\">\n      <button class=\"flex-1 flex flex-col items-center justify-center py-2.5 text-[var(--deep-ocean)]\">\n        <div class=\"bg-[var(--deep-ocean)]/10 p-2.5 rounded-xl mb-1\">\n          <svg class=\"w-6 h-6\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z\"/></svg>\n        </div>\n        <span class=\"text-[10px] font-extrabold font-urbanist uppercase tracking-tighter\">Home</span>\n      </button>\n      <button class=\"flex-1 flex flex-col items-center justify-center py-2.5 text-gray-400/80\">\n        <div class=\"p-2.5 rounded-xl mb-1\">\n          <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z\"/></svg>\n        </div>\n        <span class=\"text-[10px] font-extrabold font-urbanist uppercase tracking-tighter\">Explore</span>\n      </button>\n      \n      <div class=\"relative w-14 flex justify-center\">\n        <button id=\"add-btn\" class=\"absolute -top-12 w-14 h-14 bg-[var(--vibrant-coral)] text-white rounded-2xl shadow-[0_8px_25px_rgba(254,111,94,0.5)] flex items-center justify-center active:scale-90 transition-transform\">\n          <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M12 4v16m8-8H4\"/></svg>\n        </button>\n      </div>\n\n      <button class=\"flex-1 flex flex-col items-center justify-center py-2.5 text-gray-400/80\">\n        <div class=\"p-2.5 rounded-xl mb-1\">\n          <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z\"/></svg>\n        </div>\n        <span class=\"text-[10px] font-extrabold font-urbanist uppercase tracking-tighter\">Group</span>\n      </button>\n      <button class=\"flex-1 flex flex-col items-center justify-center py-2.5 text-gray-400/80\">\n        <div class=\"p-2.5 rounded-xl mb-1\">\n          <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M16 7a4 4 0 11-8 0 4 4 0 018 0zM4 21v-2a4 4 0 014-4h8a4 4 0 014 4v2\"/></svg>\n        </div>\n        <span class=\"text-[10px] font-extrabold font-urbanist uppercase tracking-tighter\">Me</span>\n      </button>\n    </div>\n  </nav>\n\n</div>\n\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n<script>gsap.registerPlugin(ScrollTrigger);</script>\n<script type=\"module\">\n  import { animate, scroll, spring } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import Lenis from \"https://esm.sh/lenis@1\"\n\n  // Initialize Lenis for smooth scrolling\n  const lenis = new Lenis({\n    duration: 1.2,\n    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n  })\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // GSAP Registration\n  gsap.registerPlugin(ScrollTrigger);\n\n  // 1. Parallax Hero Effect\n  gsap.to(\"#hero-image\", {\n    yPercent: 20,\n    ease: \"none\",\n    scrollTrigger: {\n      trigger: \"#hero\",\n      start: \"top top\",\n      end: \"bottom top\",\n      scrub: true\n    }\n  });\n\n  // 2. GSAP Blur In for Hero Content\n  gsap.from(\"#hero-content\", {\n    duration: 1.2,\n    y: 50,\n    autoAlpha: 0,\n    filter: \"blur(12px)\",\n    ease: \"power3.out\",\n    delay: 0.3\n  });\n\n  // 3. GSAP Blur In for Trip Cards on Scroll\n  const tripCards = [\"#trip-card-1\", \"#trip-card-2\", \"#trip-card-3\"];\n  tripCards.forEach((card, index) => {\n    gsap.from(card, {\n      scrollTrigger: {\n        trigger: card,\n        start: \"top 90%\",\n        toggleActions: \"play none none none\"\n      },\n      duration: 0.8,\n      x: 30,\n      autoAlpha: 0,\n      filter: \"blur(10px)\",\n      ease: \"power2.out\",\n      delay: index * 0.1\n    });\n  });\n\n  // 4. Trip Board Polaroid Entrance\n  gsap.from(\".trip-item\", {\n    scrollTrigger: {\n      trigger: \".trip-item\",\n      start: \"top 85%\"\n    },\n    duration: 1,\n    y: 40,\n    opacity: 0,\n    stagger: 0.15,\n    ease: \"back.out(1.7)\"\n  });\n\n  // 5. Anime Spring Bounce for Buttons (Using Motion.js spring for accuracy as per #anime-spring-bounce requirement)\n  const startBtn = document.querySelector(\"#start-btn\");\n  const addBtn = document.querySelector(\"#add-btn\");\n\n  const springConfig = { bounce: 0.4, duration: 0.6 };\n  \n  startBtn.addEventListener(\"mouseenter\", () => {\n    animate(startBtn, { scale: 1.05 }, { ease: spring(springConfig) });\n  });\n  startBtn.addEventListener(\"mouseleave\", () => {\n    animate(startBtn, { scale: 1 }, { ease: spring(springConfig) });\n  });\n\n  // 6. Collaborative Toast Slide (#motion-toast-slide-edge)\n  setTimeout(() => {\n    const toast = document.querySelector(\"#collab-toast\");\n    animate(toast, { opacity: [0, 1], x: [100, 0] }, { type: \"spring\", stiffness: 400, damping: 25 });\n    \n    // Auto remove after 5 seconds\n    setTimeout(() => {\n      animate(toast, { opacity: 0, x: 100 }, { duration: 0.4 }).finished.then(() => {\n        toast.style.display = 'none';\n      });\n    }, 5000);\n  }, 2000);\n\n</script>\n",
      "comments": [],
      "created": "2026-07-23T02:49:38.523230+00:00",
      "modified": "2026-07-23T02:49:38.523230+00:00",
      "id": "var_792211a35b4b"
    },
    "var_d902c5735ca5": {
      "type": "variant",
      "label": "Nomadic Print (Editorial)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 950,
        "y": 0,
        "w": 375,
        "h": 812
      },
      "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<body class=\"bg-[#F4F0EC] text-[#36454F] font-['Public_Sans'] min-h-screen selection:bg-[#E23D28] selection:text-white overflow-x-clip\" id=\"main-content\">\n  <link rel=\"stylesheet\" href=\"https://unpkg.com/lenis@1/dist/lenis.css\">\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,700;1,400;1,700&family=Public+Sans:wght@300;400;500;600;700&display=swap');\n\n    :root {\n      --skew: 0deg;\n    }\n\n    .font-lora { font-family: 'Lora', serif; }\n    .font-sans { font-family: 'Public_Sans', sans-serif; }\n\n    .hairline-border { border: 1px solid #36454F; }\n    .hairline-b { border-bottom: 1px solid rgba(54, 69, 79, 0.2); }\n    .hairline-t { border-top: 1px solid rgba(54, 69, 79, 0.2); }\n    \n    .skew-element {\n      transform: skewY(var(--skew));\n      will-change: transform;\n    }\n\n    .tangerine-accent { border-top: 4px solid #E23D28; }\n\n    /* Custom scrollbar for editorial feel */\n    ::-webkit-scrollbar {\n      width: 4px;\n    }\n    ::-webkit-scrollbar-track {\n      background: #F4F0EC;\n    }\n    ::-webkit-scrollbar-thumb {\n      background: #36454F;\n    }\n\n    .pull-quote-break {\n      margin-left: -1.5rem;\n      margin-right: -1.5rem;\n    }\n\n    /* Prevent GSAP flash */\n    .gsap-reveal {\n      visibility: visible;\n    }\n  </style>\n\n  <!-- Navigation -->\n  <nav class=\"fixed top-0 left-0 w-full z-50 bg-[#F4F0EC]/90 backdrop-blur-sm hairline-b px-6 py-4 flex justify-between items-baseline\">\n    <div class=\"font-lora text-2xl font-bold italic tracking-tighter\">Nomadic Print</div>\n    <div class=\"flex gap-6 items-baseline\">\n      <span class=\"text-[10px] tracking-widest uppercase font-bold opacity-40\">Issue 12</span>\n      <button class=\"press-btn menu-btn flex flex-col items-end gap-1.5 group cursor-pointer\">\n        <span class=\"w-6 h-[1px] bg-[#36454F] transition-all group-hover:w-4\"></span>\n        <span class=\"w-4 h-[1px] bg-[#36454F] transition-all group-hover:w-6\"></span>\n      </button>\n    </div>\n  </nav>\n\n  <!-- Editorial Hero Section -->\n  <section class=\"hero-section relative bg-[#F4F0EC] pt-0\">\n    <div class=\"relative w-full h-[80vh] overflow-hidden\">\n      <img id=\"hero-img\" \n           src=\"https://images.unsplash.com/photo-1527576539890-dfa815648363?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxkcmFtYXRpYyUyMGJsYWNrJTIwYW5kJTIwd2hpdGUlMjBhcmNoaXRlY3R1cmUlMjBwaG90b2dyYXBoeXxlbnwwfHx8fDE3ODQ3NzQ5NTJ8MA&ixlib=rb-4.1.0&q=85&auto=format&w=1200\" \n           alt=\"Joakim Nådell on Unsplash\" \n           class=\"w-full h-full object-cover grayscale brightness-90\"\n           decoding=\"async\" loading=\"lazy\">\n      <div class=\"absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[#F4F0EC]/80\"></div>\n    </div>\n    \n    <div class=\"relative px-6 -mt-32 pb-20 skew-element\">\n      <div class=\"bg-[#F4F0EC] p-8 hairline-border rounded-none shadow-2xl relative\">\n        <div class=\"absolute -top-1 left-0 right-0 h-1 bg-[#E23D28]\"></div>\n        <span class=\"text-[10px] uppercase tracking-[0.3em] mb-6 block text-[#E23D28] font-black\">Monograph / 2024</span>\n        <h1 id=\"hero-title\" class=\"font-lora text-[3.8rem] leading-[0.9] font-bold tracking-tight mb-8\">\n          The <span class=\"italic\">Silent</span> <br> Grids of Osaka\n        </h1>\n        <div class=\"flex flex-col md:flex-row md:items-end gap-8\">\n          <p class=\"text-base leading-relaxed opacity-90 max-w-sm\">\n            Uncovering the rhythmic structural patterns of Japan's most unyielding architectural era. A study in concrete, shadow, and preserved space.\n          </p>\n          <button class=\"press-btn bg-[#36454F] text-[#F4F0EC] px-8 py-5 text-[10px] font-bold uppercase tracking-widest flex items-center justify-between min-w-[180px] rounded-none mt-4\">\n            Read Monograph\n            <svg class=\"w-4 h-4 ml-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17 8l4 4m0 0l-4 4m4-4H3\"></path></svg>\n          </button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Discovery Stack: #card-stack-swipe -->\n  <section class=\"py-24 bg-[#36454F] text-[#F4F0EC] relative overflow-hidden\">\n    <div class=\"px-6 mb-16 flex justify-between items-end\">\n      <div>\n        <h2 class=\"font-lora text-4xl italic mb-3 font-bold\">Curated Stacks</h2>\n        <p class=\"text-[10px] uppercase tracking-[0.2em] opacity-50\">Swipe cards to archive to your board</p>\n      </div>\n      <div class=\"hidden sm:block w-32 h-[1px] bg-[#F4F0EC]/20 mb-2\"></div>\n    </div>\n\n    <div class=\"relative h-[560px] px-6\">\n      <div class=\"relative w-full h-full max-w-sm mx-auto\" id=\"card-stack\">\n        <!-- Card 3 -->\n        <div class=\"card absolute inset-0 bg-[#F4F0EC] text-[#36454F] overflow-hidden rounded-none z-0 hairline-border translate-y-12 scale-90 opacity-40\">\n           <img src=\"https://images.unsplash.com/photo-1615141328086-72a5a01b1b25?auto=format&w=600&q=80\" \n               alt=\"Vatican Shadows\" \n               class=\"w-full h-[60%] object-cover grayscale\"\n               decoding=\"async\" loading=\"lazy\">\n          <div class=\"p-8\">\n            <h3 class=\"font-lora text-2xl mb-2 font-bold\">Shadow Play</h3>\n            <p class=\"text-sm leading-relaxed opacity-70\">The geometry of modern Italian restoration projects.</p>\n          </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"card absolute inset-0 bg-[#F4F0EC] text-[#36454F] overflow-hidden rounded-none z-10 hairline-border translate-y-6 scale-95 opacity-80\">\n          <img src=\"https://images.unsplash.com/photo-1629649407271-2dac934c1f1b?auto=format&w=600&q=80\" \n               alt=\"Marrakesh Archive\" \n               class=\"w-full h-[60%] object-cover\"\n               decoding=\"async\" loading=\"lazy\">\n          <div class=\"p-8\">\n            <h3 class=\"font-lora text-2xl mb-2 font-bold\">Medina Textures</h3>\n            <p class=\"text-sm leading-relaxed opacity-70\">A study of color and grain in the heart of Morocco.</p>\n          </div>\n        </div>\n\n        <!-- Card 1 (Top) -->\n        <div class=\"card absolute inset-0 bg-[#F4F0EC] text-[#36454F] overflow-hidden rounded-none z-20 hairline-border shadow-[20px_20px_60px_rgba(0,0,0,0.4)]\">\n          <div class=\"absolute top-0 left-0 right-0 h-1 bg-[#E23D28]\"></div>\n          <img src=\"https://images.unsplash.com/photo-1758745464235-ccb8c1253074?auto=format&w=600&q=80\" \n               alt=\"The Saffron Route\" \n               class=\"w-full h-[60%] object-cover\"\n               decoding=\"async\" loading=\"lazy\">\n          <div class=\"p-8 flex flex-col h-[40%]\">\n            <h3 class=\"font-lora text-2xl mb-3 font-bold italic tracking-tight\">The Saffron Route</h3>\n            <p class=\"text-sm leading-relaxed opacity-70 flex-grow line-clamp-2\">Tracing the movement of pigment and aroma across the high deserts of central Asia.</p>\n            <div class=\"mt-auto flex justify-between items-center border-t border-[#36454F]/10 pt-4\">\n              <span class=\"text-[9px] uppercase font-bold tracking-[0.2em] text-[#E23D28]\">Discovery Abstract</span>\n              <span class=\"text-[9px] opacity-40\">Issue 12A</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- Swipe Buttons -->\n    <div class=\"mt-16 flex justify-center gap-12 items-center\">\n      <button class=\"press-btn w-16 h-16 rounded-full border border-[#F4F0EC]/30 flex items-center justify-center text-[#F4F0EC] hover:bg-white hover:text-[#36454F] transition-all\">\n        <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.5\" d=\"M6 18L18 6M6 6l12 12\"></path></svg>\n      </button>\n      <button class=\"press-btn w-16 h-16 rounded-full bg-[#E23D28] flex items-center justify-center text-white hover:scale-110 transition-transform\">\n        <svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path></svg>\n      </button>\n    </div>\n  </section>\n\n  <!-- Collaborative Moodboard: #masonry-pinterest-grid -->\n  <section class=\"py-24 px-6 relative bg-[#F4F0EC]\">\n    <div class=\"mb-16 flex flex-col gap-4\">\n      <div class=\"w-12 h-1 bg-[#E23D28]\"></div>\n      <h2 class=\"font-lora text-5xl font-bold tracking-tighter\">Moodboards</h2>\n      <div class=\"flex justify-between items-center hairline-t pt-4\">\n        <p class=\"text-[10px] uppercase tracking-[0.3em] font-black\">Archive Feed / Collab</p>\n        <button class=\"press-btn text-[10px] uppercase tracking-widest font-bold border-b border-[#36454F] pb-1\">View All</button>\n      </div>\n    </div>\n\n    <div class=\"columns-2 gap-6 space-y-6 skew-element\" id=\"masonry\">\n      <!-- Item 1 -->\n      <div class=\"break-inside-avoid relative group\">\n        <div class=\"overflow-hidden grayscale border border-[#36454F]/10 bg-white p-2\">\n          <img src=\"https://images.unsplash.com/photo-1518725414153-3d119aad7e76?auto=format&w=400&q=80\" \n               alt=\"Joey Kyber\" class=\"w-full grayscale-0 sm:grayscale group-hover:grayscale-0 transition-all duration-700\"\n               decoding=\"async\" loading=\"lazy\">\n        </div>\n        <p class=\"text-[9px] uppercase mt-3 opacity-40 tracking-[0.2em] font-bold\">01. Monolith (Osaka)</p>\n      </div>\n\n      <!-- Item 2: Pull Quote #pull-quote -->\n      <div class=\"break-inside-avoid bg-[#E23D28] p-8 text-[#F4F0EC] relative shadow-lg\">\n        <svg class=\"absolute top-4 right-4 w-6 h-6 opacity-20\" fill=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H16.017C14.9124 8 14.017 7.10457 14.017 6V3H19.017C20.6739 3 22.017 4.34315 22.017 6V15C22.017 16.6569 20.6739 18 19.017 18H16.017L14.017 21ZM4.017 21L4.017 18C4.017 16.8954 4.91243 16 6.017 16H9.017C9.56928 16 10.017 15.5523 10.017 15V9C10.017 8.44772 9.56928 8 9.017 8H6.017C4.91243 8 4.017 7.10457 4.017 6V3H9.017C10.6739 3 12.017 4.34315 12.017 6V15C12.017 16.6569 10.6739 18 9.017 18H6.017L4.017 21Z\"/></svg>\n        <p class=\"font-lora italic text-xl leading-snug mb-6\">\"The grain of the concrete here feels like woven fabric. It holds the winter fog differently than marble ever could.\"</p>\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-6 h-[1px] bg-[#F4F0EC]/50\"></div>\n          <p class=\"text-[10px] uppercase font-black tracking-widest\">Julian S.</p>\n        </div>\n      </div>\n\n      <!-- Item 3 -->\n      <div class=\"break-inside-avoid\">\n        <div class=\"overflow-hidden border border-[#36454F]/20 bg-white p-2\">\n          <img src=\"https://images.unsplash.com/photo-1669022475114-7c48b4bc6776?auto=format&w=400&q=80\" \n               alt=\"Architecture Detail\" class=\"w-full\"\n               decoding=\"async\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Item 4: Callout #sidebar-callout (adapted) -->\n      <div class=\"break-inside-avoid border-l-4 border-[#36454F] bg-[#36454F]/5 p-6\">\n        <h4 class=\"font-lora text-[11px] font-black uppercase mb-3 tracking-widest text-[#E23D28]\">Editorial Note</h4>\n        <p class=\"text-xs leading-relaxed opacity-80 italic\">\"Focus on the intersection of light at 11:14 AM. The shadow cast by the main pillar creates a perfect golden ratio against the floor tiles.\"</p>\n      </div>\n\n      <!-- Item 5 -->\n      <div class=\"break-inside-avoid\">\n        <div class=\"overflow-hidden grayscale p-1 border border-[#36454F]/10\">\n          <img src=\"https://images.unsplash.com/photo-1546702005-7f8e5aeab4a6?auto=format&w=400&q=80\" \n               alt=\"Spices\" class=\"w-full\"\n               decoding=\"async\" loading=\"lazy\">\n        </div>\n      </div>\n\n      <!-- Item 6 -->\n      <div class=\"break-inside-avoid\">\n        <img src=\"https://images.unsplash.com/photo-1634732957022-922f1c19d310?auto=format&w=400&q=80\" \n             alt=\"Stairs\" class=\"w-full grayscale border border-[#36454F]/10\"\n             decoding=\"async\" loading=\"lazy\">\n      </div>\n    </div>\n\n    <!-- Pull Quote Breakout: #full-bleed breakout style -->\n    <div class=\"pull-quote-break my-24 bg-[#36454F] text-[#F4F0EC] py-24 px-12 relative overflow-hidden text-center\">\n      <div class=\"absolute inset-0 bg-white/[0.03] pattern-grid-lg\"></div>\n      <p class=\"font-lora text-[2.4rem] italic leading-[1.1] mb-10 relative z-10 font-medium\">\n        \"Travel is not a discovery of place, but a discovery of the light that illuminates it.\"\n      </p>\n      <div class=\"flex flex-col items-center gap-4 relative z-10\">\n        <div class=\"w-16 h-[2px] bg-[#E23D28]\"></div>\n        <span class=\"text-[10px] uppercase tracking-[0.4em] font-black text-[#E23D28]\">Archive Manifesto</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"bg-[#F4F0EC] px-6 py-24 border-t border-[#36454F]\">\n    <div class=\"grid grid-cols-2 gap-16 mb-24\">\n      <div class=\"space-y-8\">\n        <h5 class=\"text-[10px] uppercase font-black tracking-[0.3em] opacity-40\">Contact</h5>\n        <ul class=\"text-[11px] space-y-4 font-bold tracking-widest\">\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Archive Access</li>\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Submissions</li>\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Editorial Desk</li>\n        </ul>\n      </div>\n      <div class=\"space-y-8\">\n        <h5 class=\"text-[10px] uppercase font-black tracking-[0.3em] opacity-40\">Social</h5>\n        <ul class=\"text-[11px] space-y-4 font-bold tracking-widest\">\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Journal</li>\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Instagram</li>\n          <li class=\"hover:text-[#E23D28] cursor-pointer\">Threads</li>\n        </ul>\n      </div>\n    </div>\n\n    <div class=\"flex flex-col items-start gap-12\">\n      <div class=\"font-lora text-6xl font-bold italic tracking-tighter opacity-10 leading-none\">Nomadic Print</div>\n      <div class=\"w-full h-[1px] bg-[#36454F]/20\"></div>\n      <div class=\"flex flex-col sm:flex-row justify-between w-full gap-4 text-[10px] uppercase tracking-[0.3em] font-black opacity-50\">\n        <span>© 2024 Archive Studio Paris / Tokyo</span>\n        <span class=\"text-[#E23D28]\">Archive Issue No. 12_A</span>\n      </div>\n    </div>\n  </footer>\n\n  <!-- Scripts -->\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/Draggable.min.js\"></script>\n  <script type=\"module\">\n    import Lenis from \"https://esm.sh/lenis@1\"\n    import { animate, press } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n\n    // Lenis Smooth Scroll\n    const lenis = new Lenis({\n      duration: 1.5,\n      easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),\n      smoothWheel: true,\n    });\n\n    function raf(time) {\n      lenis.raf(time);\n      requestAnimationFrame(raf);\n    }\n    requestAnimationFrame(raf);\n\n    // Lenis Velocity Skew\n    lenis.on('scroll', ({ velocity }) => {\n      const skewValue = Math.min(Math.max(velocity * 0.04, -5), 5); \n      document.body.style.setProperty('--skew', `${skewValue}deg`);\n    });\n\n    // Motion Press Scale\n    press(\".press-btn\", (el) => {\n      animate(el, { scale: 0.94 }, { duration: 0.2 });\n      return () => animate(el, { scale: 1 }, { duration: 0.2 });\n    });\n\n    // GSAP Card Stack Swipe Logic\n    gsap.registerPlugin(ScrollTrigger, Draggable);\n\n    const cards = gsap.utils.toArray(\".card\");\n    const stack = document.querySelector(\"#card-stack\");\n\n    function setupDraggable() {\n      const topCard = cards[cards.length - 1];\n      Draggable.create(topCard, {\n        type: \"x,y\",\n        onDragEnd: function() {\n          if (Math.abs(this.x) > 120) {\n            const outX = this.x > 0 ? 600 : -600;\n            gsap.to(topCard, {\n              x: outX,\n              y: this.y + (Math.random() * 200 - 100),\n              rotation: this.x > 0 ? 30 : -30,\n              opacity: 0,\n              duration: 0.6,\n              ease: \"power2.in\",\n              onComplete: () => {\n                const movedCard = cards.pop();\n                cards.unshift(movedCard);\n                reorderStack();\n              }\n            });\n          } else {\n            gsap.to(topCard, { x: 0, y: 0, duration: 0.5, ease: \"back.out(1.7)\" });\n          }\n        }\n      });\n    }\n\n    function reorderStack() {\n      cards.forEach((card, i) => {\n        const isTop = i === cards.length - 1;\n        gsap.set(card, { zIndex: i });\n        gsap.to(card, {\n          x: 0,\n          y: isTop ? 0 : 24 - (i * 12),\n          scale: isTop ? 1 : 0.9 + (i * 0.025),\n          opacity: isTop ? 1 : 0.4 + (i * 0.2),\n          rotation: 0,\n          duration: 0.5,\n          ease: \"power3.out\",\n          onComplete: isTop ? setupDraggable : null\n        });\n        \n        // Disable non-top card draggables\n        if (!isTop) {\n           Draggable.get(card)?.kill();\n        }\n      });\n    }\n\n    reorderStack();\n\n    // Entrance Animations\n    gsap.from(\"#hero-img\", {\n      scale: 1.2,\n      duration: 2.5,\n      ease: \"expo.out\"\n    });\n\n    gsap.from(\"#hero-title\", {\n      y: 120,\n      opacity: 0,\n      duration: 1.5,\n      delay: 0.3,\n      ease: \"power4.out\"\n    });\n\n    gsap.from(\".hero-section p, .hero-section button\", {\n      y: 40,\n      opacity: 0,\n      stagger: 0.1,\n      duration: 1.2,\n      delay: 0.8,\n      ease: \"power3.out\"\n    });\n  </script>\n</body>\n</html>\n",
      "comments": [],
      "created": "2026-07-23T02:49:38.604514+00:00",
      "modified": "2026-07-23T02:49:38.604514+00:00",
      "id": "var_d902c5735ca5"
    },
    "var_2d8666e9f0e2": {
      "type": "variant",
      "label": "TripGenie Home (Sunset Remix)",
      "parentId": "ef84c6e6-8c7d-477f-a836-a7c95b2fd957",
      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 430,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --bg-1: #19324d;\n    --bg-2: #10243a;\n    --bg-3: #071421;\n    --ink: #ffffff;\n    --ink-dim: rgba(255, 255, 255, 0.85);\n    --ink-faint: rgba(255, 255, 255, 0.58);\n    --card: rgba(22, 47, 70, 0.82);\n    --card-2: rgba(30, 58, 84, 0.92);\n    --cyan: #8cc1df;\n    --azure: #4f7fa7;\n    --turquoise: #7fa9b9;\n    --gold: #d7b679;\n    --track: rgba(255, 255, 255, 0.14);\n    --radius-lg: 28px;\n    --radius-md: 20px;\n    --radius-pill: 999px;\n    --font-display: 'Playfair Display', serif;\n    --font-ui: 'Bricolage Grotesque', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    min-height: 100vh;\n    background: radial-gradient(circle at 50% 0%, #274967 0%, #071421 80%);\n    font-family: var(--font-ui);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    overflow-x: clip;\n  }\n\n  .page-wrap {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 18px;\n    width: 430px;\n    padding: 40px 0;\n  }\n\n  .brand-tag {\n    color: rgba(255, 255, 255, 0.4);\n    font-size: 13px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    font-weight: 600;\n  }\n\n  .screen {\n    position: relative;\n    width: 430px;\n    height: 932px;\n    overflow: hidden;\n    background: \n      radial-gradient(120% 60% at 15% 8%, rgba(140, 193, 223, 0.18), transparent 55%),\n      radial-gradient(120% 70% at 85% 4%, rgba(79, 127, 167, 0.28), transparent 60%),\n      radial-gradient(100% 50% at 50% 100%, rgba(127, 169, 185, 0.08), transparent 70%),\n      linear-gradient(190deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 40px 100px -20px rgba(0,0,0,0.8);\n  }\n\n  .stars {\n    position: absolute;\n    inset: 0;\n    background-image:\n      radial-gradient(1.5px 1.5px at 20% 12%, rgba(255,255,255,0.7), transparent),\n      radial-gradient(1.5px 1.5px at 68% 6%, rgba(255,255,255,0.5), transparent),\n      radial-gradient(1px 1px at 82% 20%, rgba(255,255,255,0.6), transparent),\n      radial-gradient(1.5px 1.5px at 10% 30%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1px 1px at 40% 4%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1.5px 1.5px at 92% 45%, rgba(255,255,255,0.5), transparent),\n      radial-gradient(1px 1px at 55% 60%, rgba(255,255,255,0.3), transparent);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .status-bar {\n    position: relative;\n    z-index: 10;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 32px 4px;\n    color: var(--ink);\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .status-icons { display: flex; align-items: center; gap: 6px; }\n\n  .notch {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: 160px; height: 34px;\n    background: #000;\n    border-bottom-left-radius: 20px;\n    border-bottom-right-radius: 20px;\n    z-index: 20;\n  }\n\n  .content {\n    position: relative;\n    z-index: 5;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 10px 24px 24px;\n    overflow-y: auto;\n    scrollbar-width: none;\n    gap: 12px;\n  }\n  .content::-webkit-scrollbar { display: none; }\n\n  .top-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .icon-btn {\n    width: 44px; height: 44px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.08);\n    display: flex; align-items: center; justify-content: center;\n    color: var(--ink);\n    flex: none;\n    font-size: 20px;\n  }\n\n  .segmented {\n    flex: 1;\n    display: flex;\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: var(--radius-pill);\n    padding: 4px;\n    max-width: 240px;\n  }\n\n  .segmented span {\n    flex: 1;\n    text-align: center;\n    padding: 10px 6px;\n    border-radius: var(--radius-pill);\n    font-size: 15px;\n    font-weight: 700;\n    color: var(--ink-dim);\n    cursor: pointer;\n  }\n\n  .segmented span.active {\n    background: var(--ink);\n    color: var(--bg-1);\n  }\n\n  .companion-wrap {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    text-align: center;\n    margin-top: 4px;\n  }\n\n  .halo {\n    position: relative;\n    width: 210px; height: 210px;\n    border-radius: 50%;\n    background: radial-gradient(circle at 40% 35%, rgba(140, 193, 223, 0.16), rgba(255, 255, 255, 0) 70%);\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: inset 0 0 50px rgba(140, 193, 223, 0.08);\n  }\n\n  .orb-container {\n    width: 160px; height: 160px;\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .orb-globe {\n    width: 100%; height: 100%;\n    filter: invert(68%) sepia(16%) saturate(811%) hue-rotate(164deg) brightness(92%) contrast(88%) drop-shadow(0 0 20px rgba(140, 193, 223, 0.38));\n    animation: rotate-globe 25s linear infinite;\n    background: radial-gradient(circle, rgba(140, 193, 223, 0.1), transparent 70%);\n    border-radius: 50%;\n  }\n\n  @keyframes rotate-globe {\n    from { transform: rotate(0deg); }\n    to { transform: rotate(360deg); }\n  }\n\n  .timer-chip {\n    position: absolute;\n    right: 2px;\n    top: 60%;\n    background: rgba(10, 25, 47, 0.9);\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    border-radius: 20px;\n    padding: 10px 14px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 2px;\n    color: var(--ink);\n    font-weight: 800;\n    font-size: 13px;\n    box-shadow: 0 10px 25px rgba(0,0,0,0.4);\n    z-index: 5;\n  }\n\n  .timer-chip i {\n    color: var(--cyan);\n    font-size: 18px;\n  }\n\n  .companion-title {\n    font-family: var(--font-display);\n    font-size: 58px;\n    color: var(--ink);\n    margin: 8px 0 4px;\n    line-height: 1;\n    font-style: italic;\n    text-shadow: 0 0 20px rgba(140, 193, 223, 0.2);\n  }\n\n  .cta-btn {\n    margin-top: 10px;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    background: linear-gradient(180deg, #6d96b7, #3f6686);\n    color: var(--ink);\n    border: none;\n    font-size: 18px;\n    font-weight: 800;\n    padding: 14px 32px;\n    border-radius: var(--radius-pill);\n    box-shadow: 0 12px 24px rgba(79, 127, 167, 0.28);\n    cursor: pointer;\n  }\n\n  .next-row {\n    display: flex;\n    justify-content: flex-end;\n    align-items: center;\n    gap: 12px;\n    color: var(--ink-faint);\n    font-size: 14px;\n    font-weight: 700;\n    margin-top: 10px;\n  }\n\n  .locked-thumb {\n    width: 48px; height: 64px;\n    border-radius: 12px;\n    background-size: cover;\n    background-position: center;\n    position: relative;\n    box-shadow: 0 8px 16px rgba(0,0,0,0.4);\n    border: 1px solid rgba(255,255,255,0.08);\n  }\n\n  .locked-thumb .lock {\n    position: absolute;\n    top: -8px; right: -8px;\n    width: 24px; height: 24px;\n    border-radius: 50%;\n    background: var(--ink);\n    display: flex; align-items: center; justify-content: center;\n    color: var(--bg-1);\n    font-size: 12px;\n  }\n\n  .streak-row {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n\n  .streak-badge {\n    flex: none;\n    width: 44px; height: 44px;\n    border-radius: 16px;\n    background: var(--azure);\n    color: var(--ink);\n    font-weight: 800;\n    font-size: 18px;\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 8px 20px rgba(79, 127, 167, 0.28);\n  }\n\n  .streak-track {\n    flex: 1;\n    height: 12px;\n    border-radius: var(--radius-pill);\n    background: var(--track);\n    overflow: hidden;\n  }\n\n  .streak-fill {\n    width: 65%;\n    height: 100%;\n    border-radius: var(--radius-pill);\n    background: linear-gradient(90deg, var(--cyan), var(--azure));\n    box-shadow: 0 0 10px rgba(140, 193, 223, 0.38);\n  }\n\n  .feature-card {\n    position: relative;\n    background: linear-gradient(165deg, var(--card-2), var(--card));\n    border-radius: var(--radius-lg);\n    padding: 30px 24px 26px;\n    overflow: hidden;\n    text-align: center;\n    border: 1px solid rgba(255, 255, 255, 0.05);\n  }\n\n  .feature-icon-top {\n    position: absolute;\n    top: 20px; right: 20px;\n    width: 38px; height: 38px;\n    border-radius: 12px;\n    border: 1.5px solid rgba(255, 255, 255, 0.2);\n    display: flex; align-items: center; justify-content: center;\n    color: var(--cyan);\n    font-size: 18px;\n  }\n\n  .feature-eyebrow {\n    color: var(--ink);\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.25em;\n    text-transform: uppercase;\n  }\n\n  .feature-rule {\n    width: 40px; height: 2px;\n    background: var(--cyan);\n    margin: 12px auto 18px;\n  }\n\n  .feature-heading {\n    font-family: var(--font-display);\n    font-size: 26px;\n    line-height: 1.25;\n    color: var(--ink);\n    margin: 0 0 20px;\n    max-width: 280px;\n    margin-left: auto;\n    margin-right: auto;\n    font-weight: 700;\n  }\n\n  .constellation {\n    position: absolute;\n    left: 18px;\n    bottom: 18px;\n    width: 120px;\n    height: 100px;\n    opacity: 0.3;\n  }\n\n  .start-btn {\n    position: relative;\n    z-index: 2;\n    background: var(--ink);\n    color: var(--bg-1);\n    border: none;\n    font-size: 17px;\n    font-weight: 800;\n    padding: 12px 40px;\n    border-radius: var(--radius-pill);\n    cursor: pointer;\n  }\n\n  .activity-row {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n  }\n\n  .activity-card {\n    background: linear-gradient(165deg, var(--card-2), var(--card));\n    backdrop-filter: blur(10px);\n    border-radius: var(--radius-md);\n    padding: 18px 14px 16px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    min-height: 110px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    cursor: pointer;\n    box-shadow: 0 10px 20px rgba(0,0,0,0.1);\n  }\n\n  .activity-icon {\n    font-size: 28px;\n    color: var(--cyan);\n  }\n\n  .activity-bottom {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 6px;\n  }\n\n  .activity-name {\n    color: var(--ink);\n    font-weight: 800;\n    font-size: 16px;\n  }\n\n  .activity-ring {\n    position: relative;\n    width: 32px; height: 32px;\n    border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 13px;\n    font-weight: 800;\n    color: var(--ink);\n    flex: none;\n  }\n\n  .activity-ring::before {\n    content: \"\";\n    position: absolute;\n    inset: 4px;\n    background: #0a192f;\n    border-radius: 50%;\n    z-index: 1;\n  }\n\n  .activity-ring span {\n    position: relative;\n    z-index: 2;\n  }\n\n  .home-indicator {\n    position: absolute;\n    bottom: 10px; left: 50%;\n    transform: translateX(-50%);\n    width: 140px; height: 5px;\n    border-radius: 3px;\n    background: rgba(255, 255, 255, 0.2);\n  }\n</style>\n<div class=\"page-wrap\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"brand-tag\" data-kid=\"1-1\" data-name=\"brand tag\">\n        TripGenie · your travel partner\n    </div>\n    <div class=\"screen\" data-kid=\"1-2\" data-name=\"screen wrapper with background gradients\">\n        <div class=\"stars\" data-dynamic=\"true\" data-kid=\"1-2-1\" data-name=\"animated starry background\" data-reason=\"star layer rotated 360 degrees by GSAP every 80s\">\n        </div>\n        <div class=\"status-bar\" data-kid=\"1-2-2\" data-name=\"status bar\">\n            <span data-kid=\"1-2-2-1\" data-name=\"current time\">\n                9:41\n            </span>\n            <div class=\"notch\" data-kid=\"1-2-2-2\" data-name=\"notch shape\">\n            </div>\n            <div class=\"status-icons\" data-kid=\"1-2-2-3\" data-name=\"status icon container\">\n                <i class=\"ti ti-chart-bar\" data-kid=\"1-2-2-3-1\" data-name=\"signal strength icon\">\n                </i>\n                <i class=\"ti ti-wifi\" data-kid=\"1-2-2-3-2\" data-name=\"wifi icon\">\n                </i>\n                <i class=\"ti ti-battery-4\" data-kid=\"1-2-2-3-3\" data-name=\"battery icon\">\n                </i>\n            </div>\n        </div>\n        <div class=\"content\" data-kid=\"1-2-3\" data-name=\"content area\">\n            <div class=\"top-row\" data-kid=\"1-2-3-1\" data-name=\"header row\">\n                <div aria-label=\"Menu\" class=\"icon-btn\" data-kid=\"1-2-3-1-1\" data-name=\"menu button\">\n                    <i class=\"ti ti-menu-2\" data-kid=\"1-2-3-1-1-1\" data-name=\"menu icon\">\n                    </i>\n                </div>\n                <div class=\"segmented\" data-kid=\"1-2-3-1-2\" data-name=\"segmented control\">\n                    <span class=\"active\" data-kid=\"1-2-3-1-2-1\" data-name=\"segmented control active option\">\n                        Discover\n                    </span>\n                    <span data-kid=\"1-2-3-1-2-2\" data-name=\"segmented control inactive option\">\n                        My Trips\n                    </span>\n                </div>\n                <div aria-label=\"User\" class=\"icon-btn\" data-kid=\"1-2-3-1-3\" data-name=\"user profile button\">\n                    <i class=\"ti ti-user\" data-kid=\"1-2-3-1-3-1\" data-name=\"user icon\">\n                    </i>\n                </div>\n            </div>\n            <div class=\"companion-wrap\" data-kid=\"1-2-3-2\" data-name=\"companion wrapper\">\n                <div class=\"halo\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1\" data-name=\"globe halo glow container\" data-reason=\"container scaled and pulsed by GSAP\">\n                    <div class=\"orb-container\" data-kid=\"1-2-3-2-1-1\" data-name=\"orb container\">\n                        <img alt=\"World Globe\" class=\"orb-globe\" data-dynamic=\"true\" data-kid=\"1-2-3-2-1-1-1\" data-name=\"spinning world globe icon\" data-reason=\"CSS animation and inline style filter updated\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/wireframe-globe.svg\"/>\n                        <div class=\"timer-chip\" data-kid=\"1-2-3-2-1-1-2\" data-name=\"timer chip\">\n                            <i class=\"ti ti-clock\" data-kid=\"1-2-3-2-1-1-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span data-kid=\"1-2-3-2-1-1-2-2\" data-name=\"timer text\">\n                                2h58m\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"companion-title\" data-kid=\"1-2-3-2-2\" data-name=\"hero destination title\">\n                    Santorini\n                </div>\n                <button class=\"cta-btn\" data-kid=\"1-2-3-2-3\" data-name=\"book flight call to action button\">\n                    Book your flight\n                    <i class=\"ti ti-arrow-right\" data-kid=\"1-2-3-2-3-1\" data-name=\"arrow right icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"next-row\" data-kid=\"1-2-3-3\" data-name=\"next destination row\">\n                <span data-kid=\"1-2-3-3-1\" data-name=\"next destination label\">\n                    Next Destination\n                </span>\n                <div class=\"locked-thumb\" data-kid=\"1-2-3-3-2\" data-name=\"locked destination thumbnail\" style=\"background-image:url('https://images.pexels.com/photos/1010657/pexels-photo-1010657.jpeg?auto=compress&cs=tinysrgb&w=200')\">\n                    <div class=\"lock\" data-kid=\"1-2-3-3-2-1\" data-name=\"lock icon\">\n                        <i class=\"ti ti-lock\" data-kid=\"1-2-3-3-2-1-1\" data-name=\"lock symbol icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n            <div class=\"streak-row\" data-kid=\"1-2-3-4\" data-name=\"streak row\">\n                <div class=\"streak-badge\" data-kid=\"1-2-3-4-1\" data-name=\"streak badge\">\n                    1\n                </div>\n                <div class=\"streak-track\" data-kid=\"1-2-3-4-2\" data-name=\"streak track\">\n                    <div class=\"streak-fill\" data-kid=\"1-2-3-4-2-1\" data-name=\"streak progress fill\">\n                    </div>\n                </div>\n                <div class=\"locked-thumb small\" data-kid=\"1-2-3-4-3\" data-name=\"locked progress thumbnail\" style=\"background-image:url('https://images.pexels.com/photos/1010657/pexels-photo-1010657.jpeg?auto=compress&cs=tinysrgb&w=120')\">\n                    <div class=\"lock\" data-kid=\"1-2-3-4-3-1\" data-name=\"lock icon\">\n                        <i class=\"ti ti-lock\" data-kid=\"1-2-3-4-3-1-1\" data-name=\"lock symbol icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n            <div class=\"feature-card\" data-kid=\"1-2-3-5\" data-name=\"feature card\">\n                <div class=\"feature-icon-top\" data-kid=\"1-2-3-5-1\" data-name=\"feature icon container\">\n                    <i class=\"ti ti-sparkles\" data-kid=\"1-2-3-5-1-1\" data-name=\"sparkles icon\">\n                    </i>\n                </div>\n                <div class=\"feature-eyebrow\" data-kid=\"1-2-3-5-2\" data-name=\"feature eyebrow text\">\n                    Adventures\n                </div>\n                <div class=\"feature-rule\" data-kid=\"1-2-3-5-3\" data-name=\"feature decorative rule\">\n                </div>\n                <h3 class=\"feature-heading\" data-kid=\"1-2-3-5-4\" data-name=\"feature heading text\">\n                    Explore the crystal waters of the Mediterranean\n                </h3>\n                <svg class=\"constellation\" data-kid=\"1-2-3-5-5\" data-name=\"constellation graphic\" fill=\"none\" viewbox=\"0 0 110 90\">\n                    <path d=\"M18 20L60 55L38 82\" stroke=\"var(--cyan)\" stroke-linecap=\"round\" stroke-width=\"2\">\n                    </path>\n                    <circle cx=\"18\" cy=\"20\" fill=\"var(--cyan)\" r=\"4\">\n                    </circle>\n                    <circle cx=\"60\" cy=\"55\" fill=\"var(--cyan)\" r=\"3\">\n                    </circle>\n                    <circle cx=\"38\" cy=\"82\" fill=\"var(--cyan)\" r=\"4\">\n                    </circle>\n                </svg>\n                <button class=\"start-btn\" data-kid=\"1-2-3-5-6\" data-name=\"explore button\">\n                    Explore\n                </button>\n            </div>\n            <div class=\"activity-row\" data-kid=\"1-2-3-6\" data-name=\"activity grid\">\n                <div class=\"activity-card\" data-kid=\"1-2-3-6-1\" data-name=\"activity card\">\n                    <i class=\"ti ti-plane-departure activity-icon\" data-kid=\"1-2-3-6-1-1\" data-name=\"flight activity icon\">\n                    </i>\n                    <div class=\"activity-bottom\" data-kid=\"1-2-3-6-1-2\" data-name=\"activity card footer\">\n                        <span class=\"activity-name\" data-kid=\"1-2-3-6-1-2-1\" data-name=\"activity name text\">\n                            Flights\n                        </span>\n                        <div class=\"activity-ring\" data-kid=\"1-2-3-6-1-2-2\" data-name=\"activity ring\" style=\"background: conic-gradient(var(--azure) 120deg, rgba(255,255,255,0.1) 0deg);\">\n                            <span data-kid=\"1-2-3-6-1-2-2-1\" data-name=\"activity count text\">\n                                1\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"activity-card\" data-kid=\"1-2-3-6-2\" data-name=\"activity card\">\n                    <i class=\"ti ti-bed activity-icon\" data-kid=\"1-2-3-6-2-1\" data-name=\"hotel activity icon\" style=\"color: var(--cyan);\">\n                    </i>\n                    <div class=\"activity-bottom\" data-kid=\"1-2-3-6-2-2\" data-name=\"activity card footer\">\n                        <span class=\"activity-name\" data-kid=\"1-2-3-6-2-2-1\" data-name=\"activity name text\">\n                            Hotels\n                        </span>\n                        <div class=\"activity-ring\" data-kid=\"1-2-3-6-2-2-2\" data-name=\"activity ring\" style=\"background: conic-gradient(var(--cyan) 200deg, rgba(255,255,255,0.1) 0deg);\">\n                            <span data-kid=\"1-2-3-6-2-2-2-1\" data-name=\"activity count text\">\n                                1\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"activity-card\" data-kid=\"1-2-3-6-3\" data-name=\"activity card\">\n                    <i class=\"ti ti-map-pin activity-icon\" data-kid=\"1-2-3-6-3-1\" data-name=\"tours activity icon\" style=\"color: var(--turquoise);\">\n                    </i>\n                    <div class=\"activity-bottom\" data-kid=\"1-2-3-6-3-2\" data-name=\"activity card footer\">\n                        <span class=\"activity-name\" data-kid=\"1-2-3-6-3-2-1\" data-name=\"activity name text\">\n                            Tours\n                        </span>\n                        <div class=\"activity-ring\" data-kid=\"1-2-3-6-3-2-2\" data-name=\"activity ring\" style=\"background: rgba(255,255,255,0.1);\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-2-3-6-3-2-2-1\" data-name=\"add icon\" style=\"font-size: 10px; position: relative; z-index: 2;\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"home-indicator\" data-kid=\"1-2-4\" data-name=\"home indicator\">\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    gsap.to(\".halo\", {\n    duration: 3,\n    scale: 1.05,\n    opacity: 0.9,\n    repeat: -1,\n    yoyo: true,\n    ease: \"sine.inOut\"\n  });\n\n  gsap.to(\".stars\", {\n    duration: 80,\n    rotation: 360,\n    repeat: -1,\n    ease: \"none\"\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-23T02:59:19.893442+00:00",
      "modified": "2026-07-24T03:01:50.795994+00:00",
      "id": "var_2d8666e9f0e2",
      "viewportScrollY": 0
    },
    "var_be38253d0213": {
      "type": "variant",
      "label": "TripGenie Progress Dashboard",
      "parentId": "var_2d8666e9f0e2",
      "themeId": null,
      "rect": {
        "x": 1955,
        "y": 0,
        "w": 430,
        "h": 812
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --bg-1: #0a192f;\n    --bg-2: #050c18;\n    --bg-3: #02060c;\n    --ink: #ffffff;\n    --ink-dim: rgba(255, 255, 255, 0.85);\n    --ink-faint: rgba(255, 255, 255, 0.55);\n    --card: rgba(10, 25, 47, 0.85);\n    --card-2: rgba(16, 36, 66, 0.95);\n    --cyan: #00f2ff;\n    --azure: #007bff;\n    --turquoise: #40e0d0;\n    --lime-ready: #10b981;\n    --track: rgba(255, 255, 255, 0.12);\n    --radius-lg: 24px;\n    --radius-md: 18px;\n    --radius-pill: 999px;\n    --font-display: 'Playfair Display', serif;\n    --font-ui: 'Bricolage Grotesque', sans-serif;\n  }\n\n  body {\n    margin: 0;\n    padding: 0;\n    min-height: 100vh;\n    background: radial-gradient(circle at 50% 0%, #112240 0%, #02060c 80%);\n    font-family: var(--font-ui);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--ink);\n    overflow-x: clip;\n  }\n\n  .page-wrap {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 18px;\n    width: 430px;\n    padding: 20px 0;\n  }\n\n  .brand-tag {\n    color: rgba(255, 255, 255, 0.4);\n    font-size: 13px;\n    letter-spacing: 0.14em;\n    text-transform: uppercase;\n    font-weight: 600;\n  }\n\n  .screen {\n    position: relative;\n    width: 430px;\n    height: 932px;\n    overflow: hidden;\n    background: \n      radial-gradient(120% 60% at 15% 8%, rgba(0, 242, 255, 0.25), transparent 55%),\n      radial-gradient(120% 70% at 85% 4%, rgba(0, 123, 255, 0.35), transparent 60%),\n      radial-gradient(100% 50% at 50% 100%, rgba(64, 224, 208, 0.1), transparent 70%),\n      linear-gradient(190deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-3) 100%);\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 40px 100px -20px rgba(0,0,0,0.8);\n  }\n\n  .stars {\n    position: absolute;\n    inset: 0;\n    background-image:\n      radial-gradient(1.5px 1.5px at 20% 12%, rgba(255,255,255,0.7), transparent),\n      radial-gradient(1.5px 1.5px at 68% 6%, rgba(255,255,255,0.5), transparent),\n      radial-gradient(1px 1px at 82% 20%, rgba(255,255,255,0.6), transparent),\n      radial-gradient(1.5px 1.5px at 10% 30%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1px 1px at 40% 4%, rgba(255,255,255,0.4), transparent),\n      radial-gradient(1.5px 1.5px at 92% 45%, rgba(255,255,255,0.5), transparent),\n      radial-gradient(1px 1px at 55% 60%, rgba(255,255,255,0.3), transparent);\n    pointer-events: none;\n    z-index: 1;\n  }\n\n  .status-bar {\n    position: relative;\n    z-index: 10;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 32px 4px;\n    color: var(--ink);\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .status-icons { display: flex; align-items: center; gap: 6px; }\n\n  .notch {\n    position: absolute;\n    top: 0; left: 50%; transform: translateX(-50%);\n    width: 160px; height: 34px;\n    background: #000;\n    border-bottom-left-radius: 20px;\n    border-bottom-right-radius: 20px;\n    z-index: 20;\n  }\n\n  .content {\n    position: relative;\n    z-index: 5;\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    padding: 10px 20px 24px;\n    gap: 14px;\n    overflow-y: auto;\n    scrollbar-width: none;\n  }\n  .content::-webkit-scrollbar { display: none; }\n\n  .top-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 12px;\n  }\n\n  .icon-btn {\n    width: 42px; height: 42px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.08);\n    display: flex; align-items: center; justify-content: center;\n    color: var(--ink);\n    flex: none;\n    font-size: 18px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n  }\n\n  .segmented {\n    flex: 1;\n    display: flex;\n    background: rgba(255, 255, 255, 0.1);\n    border-radius: var(--radius-pill);\n    padding: 4px;\n    max-width: 220px;\n  }\n\n  .segmented span {\n    flex: 1;\n    text-align: center;\n    padding: 8px 6px;\n    border-radius: var(--radius-pill);\n    font-size: 14px;\n    font-weight: 700;\n    color: var(--ink-dim);\n  }\n\n  .segmented span.active {\n    background: var(--ink);\n    color: var(--bg-1);\n  }\n\n  /* Live Journey Hero Section */\n  .hero-live {\n    position: relative;\n    background: linear-gradient(135deg, rgba(16, 36, 66, 0.7), rgba(10, 25, 47, 0.85));\n    border-radius: var(--radius-lg);\n    border: 1px solid rgba(0, 242, 255, 0.25);\n    padding: 16px;\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    box-shadow: 0 10px 30px rgba(0,0,0,0.3);\n    overflow: hidden;\n    backdrop-filter: blur(12px);\n  }\n\n  .globe-wrap {\n    position: relative;\n    width: 86px;\n    height: 86px;\n    flex: none;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .globe-halo {\n    position: absolute;\n    inset: -6px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(0,242,255,0.25), transparent 70%);\n  }\n\n  .globe-img {\n    width: 100%;\n    height: 100%;\n    filter: invert(72%) sepia(95%) saturate(1915%) hue-rotate(145deg) brightness(103%) contrast(101%) drop-shadow(0 0 14px rgba(0, 242, 255, 0.6));\n  }\n\n  .route-svg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    pointer-events: none;\n  }\n\n  .hero-info {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n\n  .route-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .route-codes {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    font-weight: 800;\n    font-size: 20px;\n    letter-spacing: 0.04em;\n  }\n\n  .live-badge {\n    background: rgba(0, 242, 255, 0.15);\n    color: var(--cyan);\n    border: 1px solid rgba(0, 242, 255, 0.3);\n    padding: 2px 8px;\n    border-radius: var(--radius-pill);\n    font-size: 11px;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n  }\n\n  .live-meta {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n\n  .badge-on-time {\n    background: rgba(16, 185, 129, 0.2);\n    color: #10b981;\n    border: 1px solid rgba(16, 185, 129, 0.4);\n    padding: 2px 8px;\n    border-radius: var(--radius-pill);\n    font-weight: 700;\n    font-size: 11px;\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .countdown-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 4px;\n    color: var(--ink-dim);\n    font-size: 12px;\n    font-weight: 700;\n    background: rgba(255,255,255,0.06);\n    padding: 3px 8px;\n    border-radius: 8px;\n  }\n\n  /* Trip Progress Dashboard - Prominent Central Card */\n  .progress-card {\n    background: linear-gradient(165deg, rgba(16, 36, 66, 0.95), rgba(10, 25, 47, 0.92));\n    border: 1px solid rgba(0, 242, 255, 0.4);\n    border-radius: var(--radius-lg);\n    padding: 22px 20px 20px;\n    display: flex;\n    flex-direction: column;\n    gap: 18px;\n    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255,255,255,0.25);\n    position: relative;\n    backdrop-filter: blur(16px);\n  }\n\n  .card-top {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .dash-title {\n    font-family: var(--font-display);\n    font-size: 28px;\n    font-weight: 700;\n    line-height: 1.1;\n    font-style: italic;\n    text-shadow: 0 0 15px rgba(0, 242, 255, 0.15);\n  }\n\n  .dash-subtitle {\n    color: var(--cyan);\n    font-size: 14px;\n    font-weight: 800;\n    margin-top: 2px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .continue-cta {\n    background: linear-gradient(180deg, #0088ff, #0056b3);\n    color: #fff;\n    border: none;\n    padding: 9px 16px;\n    border-radius: var(--radius-pill);\n    font-size: 13px;\n    font-weight: 800;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    box-shadow: 0 6px 18px rgba(0, 123, 255, 0.5), inset 0 1px 1px rgba(255,255,255,0.3);\n    cursor: pointer;\n    flex: none;\n  }\n\n  /* Horizontal Timeline */\n  .timeline-row {\n    display: flex;\n    align-items: flex-start;\n    justify-content: space-between;\n    position: relative;\n    padding: 0 6px;\n    margin-top: 2px;\n  }\n\n  .timeline-track-bg {\n    position: absolute;\n    top: 14px;\n    left: 24px;\n    right: 24px;\n    height: 3px;\n    background: rgba(255, 255, 255, 0.12);\n    z-index: 1;\n  }\n\n  .timeline-track-fill {\n    position: absolute;\n    top: 14px;\n    left: 24px;\n    width: 58%;\n    height: 3px;\n    background: linear-gradient(90deg, var(--lime-ready), var(--cyan));\n    z-index: 2;\n    box-shadow: 0 0 10px var(--cyan);\n  }\n\n  .timeline-step {\n    position: relative;\n    z-index: 3;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .step-icon {\n    width: 30px;\n    height: 30px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    background: #0a192f;\n    border: 2px solid rgba(255, 255, 255, 0.2);\n    color: var(--ink-faint);\n  }\n\n  .step-icon.done {\n    background: var(--lime-ready);\n    border-color: var(--lime-ready);\n    color: #02060c;\n    box-shadow: 0 0 12px rgba(16, 185, 129, 0.6);\n  }\n\n  .step-icon.active {\n    background: var(--cyan);\n    border-color: var(--cyan);\n    color: #02060c;\n    box-shadow: 0 0 12px rgba(0, 242, 255, 0.7);\n  }\n\n  .step-label {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--ink-faint);\n  }\n\n  .step-label.active-text {\n    color: var(--ink);\n  }\n\n  /* Crew Collaboration Bar */\n  .crew-bar {\n    background: rgba(4, 14, 28, 0.5);\n    border-radius: 16px;\n    padding: 10px 14px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border: 1px solid rgba(255, 255, 255, 0.1);\n  }\n\n  .avatars {\n    display: flex;\n    align-items: center;\n  }\n\n  .avatar {\n    width: 30px;\n    height: 30px;\n    border-radius: 50%;\n    border: 2px solid var(--bg-1);\n    margin-left: -7px;\n    object-fit: cover;\n  }\n\n  .avatar:first-child { margin-left: 0; }\n\n  .crew-info {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 13px;\n    font-weight: 700;\n    color: var(--ink-dim);\n  }\n\n  .vote-pill {\n    background: rgba(242, 183, 5, 0.18);\n    color: #f2b705;\n    border: 1px solid rgba(242, 183, 5, 0.35);\n    padding: 4px 10px;\n    border-radius: var(--radius-pill);\n    font-size: 11px;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  /* Editorial Card */\n  .feature-card {\n    position: relative;\n    background: linear-gradient(165deg, var(--card-2), var(--card));\n    border-radius: var(--radius-lg);\n    padding: 16px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    overflow: hidden;\n  }\n\n  .feature-img {\n    width: 72px;\n    height: 72px;\n    border-radius: 16px;\n    object-fit: cover;\n    flex: none;\n    box-shadow: 0 6px 16px rgba(0,0,0,0.4);\n    border: 1px solid rgba(255,255,255,0.1);\n  }\n\n  .feature-content {\n    flex: 1;\n  }\n\n  .feature-eyebrow {\n    color: var(--cyan);\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n  }\n\n  .feature-title {\n    font-family: var(--font-display);\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.25;\n    margin: 3px 0 0;\n    color: var(--ink);\n  }\n\n  /* Quick Actions Cards */\n  .activity-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 10px;\n  }\n\n  .act-card {\n    background: linear-gradient(165deg, var(--card-2), var(--card));\n    border-radius: var(--radius-md);\n    padding: 14px 12px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    height: 88px;\n    border: 1px solid rgba(255, 255, 255, 0.08);\n    backdrop-filter: blur(8px);\n  }\n\n  .act-icon {\n    font-size: 22px;\n    color: var(--cyan);\n  }\n\n  .act-bottom {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n\n  .act-name {\n    font-size: 14px;\n    font-weight: 800;\n  }\n\n  .act-badge {\n    width: 22px;\n    height: 22px;\n    border-radius: 50%;\n    background: var(--azure);\n    font-size: 11px;\n    font-weight: 800;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .home-indicator {\n    position: absolute;\n    bottom: 8px; left: 50%;\n    transform: translateX(-50%);\n    width: 140px; height: 5px;\n    border-radius: 3px;\n    background: rgba(255, 255, 255, 0.25);\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .globe-img, .stars {\n      animation: none !important;\n    }\n  }\n</style>\n<div class=\"page-wrap\" data-kid=\"1\" data-name=\"page layout container\">\n    <div class=\"brand-tag\" data-kid=\"1-1\" data-name=\"brand identifier text\">\n        TripGenie · Progress Dashboard\n    </div>\n    <div class=\"screen\" data-kid=\"1-2\" data-name=\"mobile screen simulation container\">\n        <div class=\"stars\" data-kid=\"1-2-1\" data-name=\"decorative stars background layer\">\n        </div>\n        <div class=\"status-bar\" data-kid=\"1-2-2\" data-name=\"system status bar\">\n            <span data-kid=\"1-2-2-1\" data-name=\"system time clock\">\n                9:41\n            </span>\n            <div class=\"notch\" data-kid=\"1-2-2-2\" data-name=\"notch area\">\n            </div>\n            <div class=\"status-icons\" data-kid=\"1-2-2-3\" data-name=\"system status icons container\">\n                <i class=\"ti ti-chart-bar\" data-kid=\"1-2-2-3-1\" data-name=\"signal strength icon\">\n                </i>\n                <i class=\"ti ti-wifi\" data-kid=\"1-2-2-3-2\" data-name=\"wifi connection icon\">\n                </i>\n                <i class=\"ti ti-battery-4\" data-kid=\"1-2-2-3-3\" data-name=\"battery charge icon\">\n                </i>\n            </div>\n        </div>\n        <div class=\"content\" data-kid=\"1-2-3\" data-name=\"main screen content container\">\n            <!-- Top Row Nav -->\n            <div class=\"top-row\" data-kid=\"1-2-3-1\" data-name=\"header navigation row\">\n                <div aria-label=\"Menu\" class=\"icon-btn\" data-kid=\"1-2-3-1-1\" data-name=\"menu button\">\n                    <i class=\"ti ti-menu-2\" data-kid=\"1-2-3-1-1-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </div>\n                <div class=\"segmented\" data-kid=\"1-2-3-1-2\" data-name=\"segmented control container\">\n                    <span data-kid=\"1-2-3-1-2-1\" data-name=\"discover segment label\">\n                        Discover\n                    </span>\n                    <span class=\"active\" data-kid=\"1-2-3-1-2-2\" data-name=\"active my trips segment label\">\n                        My Trips\n                    </span>\n                </div>\n                <div aria-label=\"User\" class=\"icon-btn\" data-kid=\"1-2-3-1-3\" data-name=\"user profile button\">\n                    <i class=\"ti ti-user\" data-kid=\"1-2-3-1-3-1\" data-name=\"user account icon\">\n                    </i>\n                </div>\n            </div>\n            <!-- (1) LIVE JOURNEY MODE HERO -->\n            <div class=\"hero-live\" data-kid=\"1-2-3-2\" data-name=\"live journey hero card\">\n                <div class=\"globe-wrap\" data-kid=\"1-2-3-2-1\" data-name=\"globe graphic container\">\n                    <div class=\"globe-halo\" data-kid=\"1-2-3-2-1-1\" data-name=\"pulsing globe halo\">\n                    </div>\n                    <img alt=\"Glowing Wireframe Globe\" class=\"globe-img\" data-kid=\"1-2-3-2-1-2\" data-name=\"rotating wireframe globe image\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/wireframe-globe.svg\"/>\n                    <svg class=\"route-svg\" data-kid=\"1-2-3-2-1-3\" data-name=\"flight route path svg\" viewbox=\"0 0 100 100\">\n                        <path d=\"M 22,65 Q 48,22 78,35\" fill=\"none\" id=\"route-path\" stroke=\"var(--cyan)\" stroke-dasharray=\"4,3\" stroke-width=\"3\">\n                        </path>\n                        <circle cx=\"22\" cy=\"65\" fill=\"var(--cyan)\" r=\"4\">\n                        </circle>\n                        <circle cx=\"78\" cy=\"35\" fill=\"var(--lime-ready)\" r=\"4\">\n                        </circle>\n                    </svg>\n                </div>\n                <div class=\"hero-info\" data-kid=\"1-2-3-2-2\" data-name=\"hero information section\">\n                    <div class=\"route-top\" data-kid=\"1-2-3-2-2-1\" data-name=\"route code header\">\n                        <div class=\"route-codes\" data-kid=\"1-2-3-2-2-1-1\" data-name=\"airport codes container\">\n                            <span data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"departure airport code text\">\n                                LHR\n                            </span>\n                            <i class=\"ti ti-plane\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"flight icon\" style=\"color:var(--cyan); font-size:16px;\">\n                            </i>\n                            <span data-kid=\"1-2-3-2-2-1-1-3\" data-name=\"arrival airport code text\">\n                                JTR\n                            </span>\n                        </div>\n                        <span class=\"live-badge\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"live status badge\">\n                            Live\n                        </span>\n                    </div>\n                    <div class=\"live-meta\" data-kid=\"1-2-3-2-2-2\" data-name=\"live journey metadata\">\n                        <span class=\"badge-on-time\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"on-time status badge\">\n                            <i class=\"ti ti-check\" data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"checkmark icon\" style=\"font-size:10px;\">\n                            </i>\n                            On time\n                        </span>\n                        <span class=\"countdown-chip\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"departure countdown chip\">\n                            <i class=\"ti ti-clock\" data-kid=\"1-2-3-2-2-2-2-1\" data-name=\"clock icon\" style=\"color:var(--cyan);\">\n                            </i>\n                            2h 58m to departure\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <!-- (2) TRIP PROGRESS DASHBOARD (MAIN CARD) -->\n            <div class=\"progress-card\" data-kid=\"1-2-3-3\" data-name=\"trip progress dashboard card\">\n                <div class=\"card-top\" data-kid=\"1-2-3-3-1\" data-name=\"card header section\">\n                    <div data-kid=\"1-2-3-3-1-1\" data-name=\"trip title and status group\">\n                        <div class=\"dash-title\" data-kid=\"1-2-3-3-1-1-1\" data-name=\"trip name headline\">\n                            Santorini trip\n                        </div>\n                        <div class=\"dash-subtitle\" data-kid=\"1-2-3-3-1-1-2\" data-name=\"readiness status indicator\">\n                            <i class=\"ti ti-chart-donut-filled\" data-kid=\"1-2-3-3-1-1-2-1\" data-name=\"donut chart icon\" style=\"font-size:16px;\">\n                            </i>\n                            65% ready\n                        </div>\n                    </div>\n                    <button class=\"continue-cta\" data-kid=\"1-2-3-3-1-2\" data-name=\"continue planning button\">\n                        Continue planning\n                        <i class=\"ti ti-chevron-right\" data-kid=\"1-2-3-3-1-2-1\" data-name=\"chevron icon\" style=\"font-size:14px;\">\n                        </i>\n                    </button>\n                </div>\n                <!-- 4-step Timeline -->\n                <div class=\"timeline-row\" data-kid=\"1-2-3-3-2\" data-name=\"horizontal step timeline row\">\n                    <div class=\"timeline-track-bg\" data-kid=\"1-2-3-3-2-1\" data-name=\"inactive timeline track background\">\n                    </div>\n                    <div class=\"timeline-track-fill\" data-kid=\"1-2-3-3-2-2\" data-name=\"active timeline track fill\">\n                    </div>\n                    <div class=\"timeline-step\" data-kid=\"1-2-3-3-2-3\" data-name=\"flight step indicator\">\n                        <div class=\"step-icon done\" data-kid=\"1-2-3-3-2-3-1\" data-name=\"flight step circle icon\">\n                            <i class=\"ti ti-check\" data-kid=\"1-2-3-3-2-3-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </div>\n                        <span class=\"step-label active-text\" data-kid=\"1-2-3-3-2-3-2\" data-name=\"flight step label text\">\n                            Flight\n                        </span>\n                    </div>\n                    <div class=\"timeline-step\" data-kid=\"1-2-3-3-2-4\" data-name=\"stay step indicator\">\n                        <div class=\"step-icon done\" data-kid=\"1-2-3-3-2-4-1\" data-name=\"stay step circle icon\">\n                            <i class=\"ti ti-check\" data-kid=\"1-2-3-3-2-4-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </div>\n                        <span class=\"step-label active-text\" data-kid=\"1-2-3-3-2-4-2\" data-name=\"stay step label text\">\n                            Stay\n                        </span>\n                    </div>\n                    <div class=\"timeline-step\" data-kid=\"1-2-3-3-2-5\" data-name=\"ideas step indicator\">\n                        <div class=\"step-icon active\" data-kid=\"1-2-3-3-2-5-1\" data-name=\"ideas step active circle icon\">\n                            <i class=\"ti ti-bulb\" data-kid=\"1-2-3-3-2-5-1-1\" data-name=\"lightbulb icon\">\n                            </i>\n                        </div>\n                        <span class=\"step-label active-text\" data-kid=\"1-2-3-3-2-5-2\" data-name=\"ideas step label text\">\n                            Ideas\n                        </span>\n                    </div>\n                    <div class=\"timeline-step\" data-kid=\"1-2-3-3-2-6\" data-name=\"ready step indicator\">\n                        <div class=\"step-icon\" data-kid=\"1-2-3-3-2-6-1\" data-name=\"ready step circle icon\">\n                            <i class=\"ti ti-flag\" data-kid=\"1-2-3-3-2-6-1-1\" data-name=\"flag icon\">\n                            </i>\n                        </div>\n                        <span class=\"step-label\" data-kid=\"1-2-3-3-2-6-2\" data-name=\"ready step label text\">\n                            Ready\n                        </span>\n                    </div>\n                </div>\n                <!-- (3) COLLABORATIVE PLANNING CREW ROW -->\n                <div class=\"crew-bar\" data-kid=\"1-2-3-3-3\" data-name=\"collaborative crew bar\">\n                    <div class=\"crew-info\" data-kid=\"1-2-3-3-3-1\" data-name=\"traveler avatars and count group\">\n                        <div class=\"avatars\" data-kid=\"1-2-3-3-3-1-1\" data-name=\"traveler avatars list\">\n                            <img alt=\"Traveler 1\" class=\"avatar\" data-kid=\"1-2-3-3-3-1-1-1\" data-name=\"traveler 1 avatar image\" src=\"https://i.pravatar.cc/100?u=a1\"/>\n                            <img alt=\"Traveler 2\" class=\"avatar\" data-kid=\"1-2-3-3-3-1-1-2\" data-name=\"traveler 2 avatar image\" src=\"https://i.pravatar.cc/100?u=b2\"/>\n                            <img alt=\"Traveler 3\" class=\"avatar\" data-kid=\"1-2-3-3-3-1-1-3\" data-name=\"traveler 3 avatar image\" src=\"https://i.pravatar.cc/100?u=c3\"/>\n                            <img alt=\"Traveler 4\" class=\"avatar\" data-kid=\"1-2-3-3-3-1-1-4\" data-name=\"traveler 4 avatar image\" src=\"https://i.pravatar.cc/100?u=d4\"/>\n                        </div>\n                        <span data-kid=\"1-2-3-3-3-1-2\" data-name=\"traveler count text\">\n                            4 travelers\n                        </span>\n                    </div>\n                    <div class=\"vote-pill\" data-kid=\"1-2-3-3-3-2\" data-name=\"vote status pill\">\n                        <i class=\"ti ti-checkbox\" data-kid=\"1-2-3-3-3-2-1\" data-name=\"checkbox icon\" style=\"font-size:12px;\">\n                        </i>\n                        2 votes open\n                    </div>\n                </div>\n            </div>\n            <!-- EDITORIAL CARD (Adventures) -->\n            <div class=\"feature-card\" data-kid=\"1-2-3-4\" data-name=\"editorial feature card\">\n                <img alt=\"Santorini coast view by Pexels photographer\" class=\"feature-img\" data-kid=\"1-2-3-4-1\" data-name=\"feature image\" src=\"https://images.pexels.com/photos/1010657/pexels-photo-1010657.jpeg?auto=compress&cs=tinysrgb&w=200\"/>\n                <div class=\"feature-content\" data-kid=\"1-2-3-4-2\" data-name=\"feature text content\">\n                    <div class=\"feature-eyebrow\" data-kid=\"1-2-3-4-2-1\" data-name=\"editorial section label\">\n                        Adventures\n                    </div>\n                    <h3 class=\"feature-title\" data-kid=\"1-2-3-4-2-2\" data-name=\"editorial headline text\">\n                        Make the most of your first day\n                    </h3>\n                </div>\n                <i class=\"ti ti-chevron-right\" data-kid=\"1-2-3-4-3\" data-name=\"forward navigation icon\" style=\"color:var(--ink-faint); font-size:20px;\">\n                </i>\n            </div>\n            <!-- QUICK ACTION CARDS -->\n            <div class=\"activity-grid\" data-kid=\"1-2-3-5\" data-name=\"quick actions grid\">\n                <div class=\"act-card\" data-kid=\"1-2-3-5-1\" data-name=\"flights quick action card\">\n                    <i class=\"ti ti-plane-departure act-icon\" data-kid=\"1-2-3-5-1-1\" data-name=\"flights icon\">\n                    </i>\n                    <div class=\"act-bottom\" data-kid=\"1-2-3-5-1-2\" data-name=\"flights card bottom section\">\n                        <span class=\"act-name\" data-kid=\"1-2-3-5-1-2-1\" data-name=\"flights card label\">\n                            Flights\n                        </span>\n                        <div class=\"act-badge\" data-kid=\"1-2-3-5-1-2-2\" data-name=\"flights notification badge\">\n                            1\n                        </div>\n                    </div>\n                </div>\n                <div class=\"act-card\" data-kid=\"1-2-3-5-2\" data-name=\"hotels quick action card\">\n                    <i class=\"ti ti-bed act-icon\" data-kid=\"1-2-3-5-2-1\" data-name=\"hotels icon\" style=\"color:var(--cyan);\">\n                    </i>\n                    <div class=\"act-bottom\" data-kid=\"1-2-3-5-2-2\" data-name=\"hotels card bottom section\">\n                        <span class=\"act-name\" data-kid=\"1-2-3-5-2-2-1\" data-name=\"hotels card label\">\n                            Hotels\n                        </span>\n                        <div class=\"act-badge\" data-kid=\"1-2-3-5-2-2-2\" data-name=\"hotels notification badge\">\n                            1\n                        </div>\n                    </div>\n                </div>\n                <div class=\"act-card\" data-kid=\"1-2-3-5-3\" data-name=\"tours quick action card\">\n                    <i class=\"ti ti-map-pin act-icon\" data-kid=\"1-2-3-5-3-1\" data-name=\"tours icon\" style=\"color:var(--turquoise);\">\n                    </i>\n                    <div class=\"act-bottom\" data-kid=\"1-2-3-5-3-2\" data-name=\"tours card bottom section\">\n                        <span class=\"act-name\" data-kid=\"1-2-3-5-3-2-1\" data-name=\"tours card label\">\n                            Tours\n                        </span>\n                        <div class=\"act-badge\" data-kid=\"1-2-3-5-3-2-2\" data-name=\"add tour button badge\" style=\"background:rgba(255,255,255,0.15);\">\n                            <i class=\"ti ti-plus\" data-kid=\"1-2-3-5-3-2-2-1\" data-name=\"plus icon\" style=\"font-size:12px;\">\n                            </i>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"home-indicator\" data-kid=\"1-2-4\" data-name=\"home indicator bar\">\n        </div>\n    </div>\n</div>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script>\n    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n    gsap.to(\".globe-img\", {\n      rotation: 360,\n      duration: 25,\n      repeat: -1,\n      ease: \"none\"\n    });\n\n    gsap.to(\".stars\", {\n      rotation: 360,\n      duration: 80,\n      repeat: -1,\n      ease: \"none\"\n    });\n\n    gsap.to(\".globe-halo\", {\n      scale: 1.15,\n      opacity: 0.6,\n      duration: 2,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n\n    gsap.to(\".timeline-track-fill\", {\n      boxShadow: \"0 0 16px #00f2ff\",\n      duration: 1.5,\n      repeat: -1,\n      yoyo: true,\n      ease: \"sine.inOut\"\n    });\n  }\n</script>\n",
